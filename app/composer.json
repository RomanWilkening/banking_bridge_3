{
    "name": "fints-homeassistant/banking-bridge",
    "description": "FinTS Banking Bridge for Home Assistant with MQTT",
    "type": "project",
    "require": {
        "php": "^8.2",
        "slim/slim": "^4.13",
        "slim/psr7": "^1.6",
        "slim/twig-view": "^3.4",
        "php-di/php-di": "^7.0",
        "php-di/slim-bridge": "^3.4",
        "nemiah/php-fints": "^3.1",
        "monolog/monolog": "^3.5",
        "php-mqtt/client": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "start": "php -S 0.0.0.0:8080 -t public",
        "test": [
            "@php tests/config-security.php",
            "@php tests/database_authorization.php",
            "@php tests/database_integrity.php",
            "@php tests/paypal_integrity.php",
            "@php tests/fints-authorization.php",
            "@php tests/auto-sync-safe.php",
            "@php tests/mqtt-reasons.php",
            "@php tests/mqtt-authorization.php",
            "@php tests/ui-authorization.php"
        ],
        "test:ui": "node tests/ui-authorization.js"
    }
}
