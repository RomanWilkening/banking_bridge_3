{% extends "layout.twig" %}

{% block content %}
<div x-data="depotDetails({{ account.id }}, {{ account.bank_id }})" class="space-y-6">
    <div class="rounded-lg bg-white p-4 shadow">
        {% include 'banks/authorization-status.twig' with {bank: bank} only %}
        <p class="text-xs text-gray-500">Hintergrund-Synchronisierung: {{ (account.background_sync_enabled ?? 1) ? 'aktiv' : 'ausgeschlossen' }}. Normale Abrufe fordern niemals automatisch eine TAN an.</p>
        <a href="/banks/{{ bank.id }}#authorization" class="text-sm text-primary-600">Bankzugang verwalten / freigeben →</a>
    </div>
    <!-- Depot Header -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
        <div class="px-4 py-5 sm:px-6 flex justify-between items-center border-b border-gray-200">
            <div class="flex items-center">
                <span class="inline-flex items-center justify-center h-14 w-14 rounded-full bg-purple-100">
                    <span class="text-2xl">📈</span>
                </span>
                <div class="ml-4" x-data="editableName('account', {{ account.id }}, '{{ (account.custom_name ?? account.account_name ?? 'Depot')|e('js') }}')">
                    <div class="flex items-center gap-2">
                        <h3 x-show="!editing" class="text-lg font-medium text-gray-900" x-text="displayName"></h3>
                        <input x-show="editing" x-model="editName" @keyup.enter="save" @keyup.escape="cancel"
                               x-ref="nameInput" type="text"
                               class="text-lg font-medium text-gray-900 border-b border-purple-500 focus:outline-none bg-transparent">
                        <button x-show="!editing" @click="edit" class="text-gray-400 hover:text-purple-500" title="Umbenennen">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
                            </svg>
                        </button>
                        <button x-show="editing" @click="save" class="text-green-500 hover:text-green-600">✓</button>
                        <button x-show="editing" @click="cancel" class="text-red-500 hover:text-red-600">✕</button>
                    </div>
                    <p class="text-sm text-gray-500">Depot {{ account.account_number }}</p>
                    <p class="text-xs text-gray-400">{{ bank.name }}</p>
                </div>
            </div>
            <div class="text-right">
                {% if total_value is not null %}
                <p class="text-2xl font-bold text-gray-900">
                    {{ total_value|number_format(2, ',', '.') }} {{ account.currency }}
                </p>
                <p class="text-sm {% if total_profit_loss >= 0 %}text-green-600{% else %}text-red-600{% endif %}">
                    {% if total_profit_loss >= 0 %}+{% endif %}{{ total_profit_loss|number_format(2, ',', '.') }} {{ account.currency }}
                </p>
                {% if account.balance_date %}
                <p class="text-xs text-gray-400">Stand: {{ account.balance_date|date('d.m.Y H:i') }}</p>
                {% endif %}
                {% else %}
                <p class="text-lg text-gray-400">Kein Bestand</p>
                {% endif %}
            </div>
        </div>
        
        <div class="px-4 py-3 bg-gray-50 flex justify-between items-center">
            <div class="flex gap-6 text-sm text-gray-500">
                <span>{{ holdings_count }} Wertpapiere</span>
                {% if linked_accounts_count > 0 %}
                <span>+ {{ linked_accounts_count }} verknüpfte Konten</span>
                {% endif %}
            </div>
            <button @click="syncHoldings" :disabled="syncing"
                    class="inline-flex items-center rounded-md bg-purple-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-purple-500 disabled:opacity-50">
                <span x-show="syncing" class="loading-spinner mr-2"></span>
                <span x-text="syncing ? 'Synchronisiere...' : 'Depotbestand abrufen'"></span>
            </button>
        </div>
        
        {% if linked_accounts_count > 0 %}
        <!-- Summary with breakdown -->
        <div class="px-4 py-3 border-t border-gray-200">
            <div class="grid grid-cols-3 gap-4 text-sm">
                <div>
                    <span class="text-gray-500">Wertpapiere:</span>
                    <span class="ml-2 font-medium">{{ securities_value|number_format(2, ',', '.') }} EUR</span>
                </div>
                <div>
                    <span class="text-gray-500">Cash/Konten:</span>
                    <span class="ml-2 font-medium">{{ linked_accounts_value|number_format(2, ',', '.') }} EUR</span>
                </div>
                <div>
                    <span class="text-gray-500">Gesamt:</span>
                    <span class="ml-2 font-bold">{{ total_value|number_format(2, ',', '.') }} EUR</span>
                </div>
            </div>
        </div>
        {% endif %}
    </div>

    <!-- Messages -->
    <div x-show="message" x-cloak>
        <div x-show="message?.type === 'success'" class="rounded-md bg-green-50 p-4">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="ml-3">
                    <p class="text-sm font-medium text-green-800" x-text="message?.text"></p>
                </div>
            </div>
        </div>
        <div x-show="message?.type === 'error'" class="rounded-md bg-red-50 p-4">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="ml-3">
                    <p class="text-sm font-medium text-red-800" x-text="message?.text"></p>
                </div>
            </div>
        </div>
    </div>

    <!-- Holdings List -->
    <div class="bg-white shadow rounded-lg">
        <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
            <h3 class="text-lg font-medium leading-6 text-gray-900">Wertpapierbestand</h3>
        </div>
        
        {% if holdings|length > 0 %}
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Wertpapier</th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Anzahl</th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Kurs</th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Wert</th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Gewinn/Verlust</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    {% for holding in holdings %}
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4 text-sm text-gray-900">
                            <div class="font-medium">{{ holding.name }}</div>
                            <div class="text-xs text-gray-400">
                                {% if holding.isin %}ISIN: {{ holding.isin }}{% endif %}
                                {% if holding.wkn %} | WKN: {{ holding.wkn }}{% endif %}
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-gray-900">
                            {{ holding.quantity|number_format(4, ',', '.') }}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-gray-500">
                            {% if holding.current_price %}
                            {{ holding.current_price|number_format(2, ',', '.') }} {{ holding.currency }}
                            {% if holding.price_date %}
                            <div class="text-xs text-gray-400">{{ holding.price_date|date('d.m.Y') }}</div>
                            {% endif %}
                            {% else %}
                            -
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-right font-medium text-gray-900">
                            {% if holding.total_value %}
                            {{ holding.total_value|number_format(2, ',', '.') }} {{ holding.currency }}
                            {% else %}
                            -
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-right font-medium">
                            {% if holding.profit_loss is not null %}
                            <span class="{% if holding.profit_loss >= 0 %}text-green-600{% else %}text-red-600{% endif %}">
                                {% if holding.profit_loss >= 0 %}+{% endif %}{{ holding.profit_loss|number_format(2, ',', '.') }} {{ holding.currency }}
                            </span>
                            {% if holding.profit_loss_percent is not null %}
                            <div class="text-xs {% if holding.profit_loss_percent >= 0 %}text-green-500{% else %}text-red-500{% endif %}">
                                ({% if holding.profit_loss_percent >= 0 %}+{% endif %}{{ holding.profit_loss_percent|number_format(2, ',', '.') }}%)
                            </div>
                            {% endif %}
                            {% else %}
                            <span class="text-gray-400">-</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                    
                    {% if linked_accounts|length > 0 %}
                    <!-- Separator row -->
                    <tr class="bg-blue-50">
                        <td colspan="5" class="px-6 py-2 text-xs font-medium text-blue-700 uppercase">
                            💰 Verknüpfte Konten (Cash)
                        </td>
                    </tr>
                    {% for acc in linked_accounts %}
                    <tr class="hover:bg-blue-50/50 bg-blue-50/20">
                        <td class="px-6 py-4 text-sm text-gray-900">
                            <div class="font-medium flex items-center gap-2">
                                <span class="text-blue-500">💳</span>
                                {{ acc.custom_name ?? acc.account_name ?? 'Konto' }}
                            </div>
                            <div class="text-xs text-gray-400">
                                {{ acc.bank_name }} | {{ acc.iban }}
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-gray-500">
                            -
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-gray-500">
                            -
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-right font-medium text-gray-900">
                            {% if acc.balance is not null %}
                            {{ acc.balance|number_format(2, ',', '.') }} {{ acc.currency }}
                            {% else %}
                            -
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-right text-gray-400">
                            -
                        </td>
                    </tr>
                    {% endfor %}
                    {% endif %}
                </tbody>
                <tfoot class="bg-gray-50">
                    <tr>
                        <td colspan="3" class="px-6 py-4 text-sm font-medium text-gray-900">Gesamt</td>
                        <td class="px-6 py-4 text-sm text-right font-bold text-gray-900">
                            {{ total_value|number_format(2, ',', '.') }} EUR
                        </td>
                        <td class="px-6 py-4 text-sm text-right font-bold {% if total_profit_loss >= 0 %}text-green-600{% else %}text-red-600{% endif %}">
                            {% if total_profit_loss >= 0 %}+{% endif %}{{ total_profit_loss|number_format(2, ',', '.') }} EUR
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>

        {% else %}
        <div class="px-4 py-12 text-center">
            <span class="text-4xl">📊</span>
            <p class="mt-2 text-sm text-gray-500">Noch kein Depotbestand</p>
            <p class="text-sm text-gray-400">Klicken Sie auf "Depotbestand abrufen" um die Wertpapiere von der Bank zu laden</p>
        </div>
        {% endif %}
    </div>

    <!-- Back Link -->
    <div>
        <a href="/banks/{{ bank.id }}" class="text-sm text-purple-600 hover:text-purple-500">← Zurück zur Bank</a>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
function editableName(type, id, initialName) {
    return {
        type: type,
        id: id,
        displayName: initialName,
        editName: initialName,
        editing: false,
        
        edit() {
            this.editName = this.displayName;
            this.editing = true;
            this.$nextTick(() => this.$refs.nameInput.focus());
        },
        
        async save() {
            if (!this.editName.trim()) {
                this.cancel();
                return;
            }
            
            const url = this.type === 'bank' 
                ? `/api/banks/${this.id}` 
                : `/api/accounts/${this.id}`;
            
            try {
                const response = await fetch(url, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name: this.editName.trim() })
                });
                const data = await response.json();
                
                if (data.success) {
                    this.displayName = this.editName.trim();
                    this.editing = false;
                } else {
                    alert(data.message || 'Fehler beim Speichern');
                }
            } catch (error) {
                alert('Netzwerkfehler: ' + error.message);
            }
        },
        
        cancel() {
            this.editName = this.displayName;
            this.editing = false;
        }
    };
}

function depotDetails(accountId, bankId) {
    return {
        accountId: accountId,
        bankId: bankId,
        syncing: false,
        message: null,

        async syncHoldings() {
            this.syncing = true;
            this.message = null;

            try {
                const response = await fetch(`/api/accounts/${this.accountId}/depot`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });
                const data = await response.json();

                const warning = safeSyncWarning(data);
                if (warning) {
                    this.message = { type: 'error', text: warning };
                } else if (data.success) {
                    this.message = { type: 'success', text: `${data.count} Wertpapiere synchronisiert!` };
                    setTimeout(() => location.reload(), 1500);
                } else {
                    this.message = { type: 'error', text: data.message || 'Fehler beim Synchronisieren' };
                }
            } catch (error) {
                this.message = { type: 'error', text: 'Netzwerkfehler: ' + error.message };
            }

            this.syncing = false;
        },

    }
}
</script>
{% endblock %}
