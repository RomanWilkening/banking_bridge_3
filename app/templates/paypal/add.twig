{% extends "layout.twig" %}

{% block content %}
<div class="max-w-2xl mx-auto">
    <div class="mb-6">
        <a href="/paypal" class="text-sm text-gray-500 hover:text-gray-700 flex items-center">
            <svg class="mr-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Zurück zu PayPal
        </a>
    </div>

    <div class="bg-white shadow rounded-lg">
        <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">PayPal-Konto hinzufügen</h2>
            <p class="mt-1 text-sm text-gray-500">Verbinde dein PayPal-Konto mit den API-Credentials</p>
        </div>

        {% if error %}
        <div class="mx-4 mt-4 rounded-md bg-red-50 p-4">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="ml-3">
                    <p class="text-sm font-medium text-red-800">{{ error }}</p>
                </div>
            </div>
        </div>
        {% endif %}

        <form method="POST" action="/paypal/add" class="p-6 space-y-6" x-data="paypalForm()">
            <div>
                <label for="name" class="block text-sm font-medium text-gray-700">Name *</label>
                <input type="text" name="name" id="name" required
                       class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm border px-3 py-2"
                       placeholder="z.B. Mein PayPal"
                       value="{{ data.name|default('') }}">
            </div>

            <div>
                <label for="email" class="block text-sm font-medium text-gray-700">PayPal E-Mail</label>
                <input type="email" name="email" id="email"
                       class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm border px-3 py-2"
                       placeholder="deine@email.de"
                       value="{{ data.email|default('') }}">
            </div>

            <div class="bg-blue-50 p-4 rounded-md">
                <h3 class="text-sm font-medium text-blue-800 mb-2">API-Credentials</h3>
                <p class="text-sm text-blue-700 mb-3">
                    Du findest diese in deinem PayPal-Konto unter:<br>
                    <strong>Einstellungen → Kontodaten → API-Zugriff</strong>
                </p>
            </div>

            <div>
                <label for="api_username" class="block text-sm font-medium text-gray-700">API-Benutzername *</label>
                <input type="text" name="api_username" id="api_username" required x-model="apiUsername"
                       class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm border px-3 py-2 font-mono text-sm"
                       placeholder="xxx_api1.email.de"
                       value="{{ data.api_username|default('') }}">
            </div>

            <div>
                <label for="api_password" class="block text-sm font-medium text-gray-700">API-Passwort *</label>
                <input type="password" name="api_password" id="api_password" required x-model="apiPassword"
                       class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm border px-3 py-2 font-mono text-sm"
                       placeholder="••••••••"
                       value="{{ data.api_password|default('') }}">
            </div>

            <div>
                <label for="api_signature" class="block text-sm font-medium text-gray-700">Signatur *</label>
                <input type="password" name="api_signature" id="api_signature" required x-model="apiSignature"
                       class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm border px-3 py-2 font-mono text-sm"
                       placeholder="••••••••"
                       value="{{ data.api_signature|default('') }}">
            </div>

            <div>
                <label for="currency" class="block text-sm font-medium text-gray-700">Hauptwährung</label>
                <select name="currency" id="currency"
                        class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm border px-3 py-2">
                    <option value="EUR" {{ data.currency|default('EUR') == 'EUR' ? 'selected' : '' }}>EUR - Euro</option>
                    <option value="USD" {{ data.currency|default('') == 'USD' ? 'selected' : '' }}>USD - US Dollar</option>
                    <option value="GBP" {{ data.currency|default('') == 'GBP' ? 'selected' : '' }}>GBP - Britische Pfund</option>
                </select>
            </div>

            <!-- Test Connection Button -->
            <div class="pt-2">
                <button type="button" @click="testConnection" :disabled="testing || !canTest"
                        class="inline-flex items-center rounded-md bg-gray-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-gray-500 disabled:opacity-50 disabled:cursor-not-allowed">
                    <span x-show="testing" class="mr-2">
                        <svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </span>
                    <span x-text="testing ? 'Teste...' : 'Verbindung testen'"></span>
                </button>
            </div>

            <div x-show="testMessage" x-cloak class="rounded-md p-3" :class="testSuccess ? 'bg-green-50' : 'bg-red-50'">
                <p class="text-sm" :class="testSuccess ? 'text-green-800' : 'text-red-800'" x-text="testMessage"></p>
            </div>

            <div class="flex justify-end space-x-3 pt-4 border-t border-gray-200">
                <a href="/paypal" class="inline-flex items-center rounded-md bg-white px-4 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
                    Abbrechen
                </a>
                <button type="submit"
                        class="inline-flex items-center rounded-md bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-primary-500">
                    PayPal hinzufügen
                </button>
            </div>
        </form>
    </div>
</div>

<script>
function paypalForm() {
    return {
        apiUsername: '{{ data.api_username|default('')|e('js') }}',
        apiPassword: '{{ data.api_password|default('')|e('js') }}',
        apiSignature: '{{ data.api_signature|default('')|e('js') }}',
        testing: false,
        testMessage: '',
        testSuccess: false,
        
        get canTest() {
            return this.apiUsername && this.apiPassword && this.apiSignature;
        },
        
        async testConnection() {
            this.testing = true;
            this.testMessage = '';
            
            try {
                const response = await fetch('/api/paypal/test', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        api_username: this.apiUsername,
                        api_password: this.apiPassword,
                        api_signature: this.apiSignature
                    })
                });
                
                const data = await response.json();
                this.testMessage = data.message;
                this.testSuccess = data.success;
            } catch (error) {
                this.testMessage = 'Verbindungsfehler: ' + error.message;
                this.testSuccess = false;
            }
            
            this.testing = false;
        }
    };
}
</script>
{% endblock %}
