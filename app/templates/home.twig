{% extends "layout.twig" %}

{% block content %}
<div class="space-y-6" x-data="dashboardSync()">
    <!-- Header with Sync All Button -->
    {% if banks|length > 0 %}
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Dashboard</h1>
            <p class="text-sm text-gray-500">Jede Bankverbindung wird getrennt geführt, auch bei gleicher BLZ. Synchronisierung ohne automatische TAN.</p>
        </div>
        <button @click="syncAllBanks" :disabled="syncing"
                class="inline-flex items-center rounded-md bg-gradient-to-r from-primary-600 to-green-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:from-primary-500 hover:to-green-500 disabled:opacity-50 disabled:cursor-not-allowed">
            <span x-show="syncing" class="loading-spinner mr-2"></span>
            <span x-text="syncing ? 'Synchronisiere...' : '🔄 Alle Banken synchronisieren'"></span>
        </button>
    </div>
    {% endif %}

    <!-- Sync Progress -->
    <div x-show="syncing || results.length > 0" x-cloak class="bg-white shadow rounded-lg p-4">
        <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm font-semibold text-gray-900">Synchronisierungsfortschritt</h3>
            <button x-show="!syncing && results.length > 0" @click="clearResults" class="text-xs text-gray-500 hover:text-gray-700">
                Ausblenden
            </button>
            <a x-show="!syncing && results.length > 0" href="/" class="text-xs text-primary-600">Datenansicht neu laden</a>
        </div>
        
        <!-- Progress Bar -->
        <div x-show="syncing" class="mb-4">
            <div class="flex justify-between text-xs text-gray-500 mb-1">
                <span x-text="currentBankName || 'Starte...'"></span>
                <span x-text="`${currentBankIndex + 1} / ${totalBanks}`"></span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2">
                <div class="bg-primary-600 h-2 rounded-full transition-all duration-300" 
                     :style="`width: ${totalBanks > 0 ? ((currentBankIndex + 1) / totalBanks * 100) : 0}%`"></div>
            </div>
        </div>

        <!-- Results List -->
        <div class="space-y-2 max-h-60 overflow-y-auto">
            <template x-for="(result, idx) in results" :key="idx">
                <div class="flex items-start gap-3 p-2 rounded-lg" 
                     :class="result.success ? 'bg-green-50' : (result.error ? 'bg-red-50' : 'bg-yellow-50')">
                    <span x-text="result.success ? '✓' : (result.error ? '✗' : '⚠')" 
                          :class="result.success ? 'text-green-600' : (result.error ? 'text-red-600' : 'text-yellow-600')"></span>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium text-gray-900" x-text="result.bankName"></p>
                        <p class="text-xs text-gray-600" x-text="result.message"></p>
                        <a :href="`/banks/${result.bankId}`" class="text-xs text-primary-600">Bankzugang verwalten →</a>
                    </div>
                </div>
            </template>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
        <div class="bg-white overflow-hidden shadow rounded-lg">
            <div class="p-5">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <span class="text-3xl">🏦</span>
                    </div>
                    <div class="ml-5 w-0 flex-1">
                        <dl>
                            <dt class="text-sm font-medium text-gray-500 truncate">Verbundene Banken</dt>
                            <dd class="text-lg font-semibold text-gray-900">{{ banks|length }}</dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-5 py-3">
                <a href="/banks/add" class="text-sm font-medium text-primary-600 hover:text-primary-500">
                    Bank hinzufügen →
                </a>
            </div>
        </div>

        <div class="bg-white overflow-hidden shadow rounded-lg">
            <div class="p-5">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <span class="text-3xl">💳</span>
                    </div>
                    <div class="ml-5 w-0 flex-1">
                        <dl>
                            <dt class="text-sm font-medium text-gray-500 truncate">Konten gesamt</dt>
                            <dd class="text-lg font-semibold text-gray-900">
                                {% set total_accounts = 0 %}
                                {% for bank in banks %}
                                    {% set total_accounts = total_accounts + bank.account_count %}
                                {% endfor %}
                                {{ total_accounts }}
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-5 py-3">
                <a href="/banks" class="text-sm font-medium text-primary-600 hover:text-primary-500">
                    Alle anzeigen →
                </a>
            </div>
        </div>

        <div class="bg-white overflow-hidden shadow rounded-lg">
            <div class="p-5">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <span class="text-3xl">💰</span>
                    </div>
                    <div class="ml-5 w-0 flex-1">
                        <dl>
                            <dt class="text-sm font-medium text-gray-500">Gesamtsalden nach Währung (ohne Umrechnung)</dt>
                            <dd class="text-lg font-semibold text-gray-900">
                                {% for currency, balance in total_balances %}
                                    <div>{{ balance|number_format(2, ',', '.') }} {{ currency }}</div>
                                {% else %}
                                    Keine Salden vorhanden
                                {% endfor %}
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-5 py-3">
                <span class="text-sm text-gray-500">Inkl. {{ paypal_accounts|length }} PayPal-Konto(en)</span>
            </div>
        </div>
    </div>

    <!-- Banks List -->
    {% if banks|length > 0 %}
    <div class="bg-white shadow rounded-lg">
        <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
            <h3 class="text-lg font-medium leading-6 text-gray-900">Ihre Bankverbindungen</h3>
        </div>
        <ul role="list" class="divide-y divide-gray-200">
            {% for bank in banks %}
            <li>
                <a href="/banks/{{ bank.id }}" class="block hover:bg-gray-50">
                    <div class="px-4 py-4 sm:px-6">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center">
                                <div class="flex-shrink-0">
                                    <span class="inline-flex items-center justify-center h-12 w-12 rounded-full bg-primary-100">
                                        <span class="text-xl">🏦</span>
                                    </span>
                                </div>
                                <div class="ml-4">
                                    <p class="text-sm font-medium text-primary-600">{{ bank.name }}</p>
                                    <p class="text-sm text-gray-500">BLZ: {{ bank.bank_code }}</p>
                                    {% include 'banks/authorization-status.twig' with {bank: bank} only %}
                                    <p class="text-xs text-gray-500">Bankzugang verwalten →</p>
                                </div>
                            </div>
                            <div class="flex items-center space-x-4">
                                <div class="text-right">
                                    {% for currency, balance in bank.total_balances %}
                                    <p class="text-sm font-semibold text-gray-900">{{ balance|number_format(2, ',', '.') }} {{ currency }}</p>
                                    {% else %}
                                    <p class="text-sm text-gray-500">Keine Salden vorhanden</p>
                                    {% endfor %}
                                    <p class="text-sm text-gray-500">{{ bank.account_count }} Konto(en)</p>
                                    {% if bank.oldest_balance_date %}
                                    <p class="text-xs text-gray-500">Ältester Saldenstand: {{ date(bank.oldest_balance_date, 'UTC')|date('d.m.Y H:i', 'UTC') }} UTC</p>
                                    {% endif %}
                                    {% if bank.missing_balance_count %}
                                    <p class="text-xs text-amber-700">{{ bank.missing_balance_count }} Konto(en) ohne verlässlichen Saldenstand</p>
                                    {% endif %}
                                </div>
                                <svg class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                                </svg>
                            </div>
                        </div>
                    </div>
                </a>
            </li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}

    <!-- PayPal Accounts -->
    {% if paypal_accounts|length > 0 %}
    <div class="bg-white shadow rounded-lg">
        <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
            <h3 class="text-lg font-medium leading-6 text-gray-900">PayPal-Konten</h3>
        </div>
        <ul role="list" class="divide-y divide-gray-200">
            {% for paypal in paypal_accounts %}
            <li>
                <a href="/paypal/{{ paypal.id }}" class="block hover:bg-gray-50">
                    <div class="px-4 py-4 sm:px-6">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center">
                                <div class="flex-shrink-0">
                                    <span class="inline-flex items-center justify-center h-12 w-12 rounded-full bg-blue-100">
                                        <svg class="h-6 w-6 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M7.076 21.337H2.47a.641.641 0 0 1-.633-.74L4.944.901C5.026.382 5.474 0 5.998 0h7.46c2.57 0 4.578.543 5.69 1.81 1.01 1.15 1.304 2.42 1.012 4.287-.023.143-.047.288-.077.437-.983 5.05-4.349 6.797-8.647 6.797h-2.19a.971.971 0 0 0-.958.819l-.007.034-.737 4.669-.008.034a.64.64 0 0 1-.63.45z"/>
                                        </svg>
                                    </span>
                                </div>
                                <div class="ml-4">
                                    <p class="text-sm font-medium text-blue-600">{{ paypal.name }}</p>
                                    {% if paypal.email %}
                                    <p class="text-sm text-gray-500">{{ paypal.email }}</p>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="flex items-center space-x-4">
                                <div class="text-right">
                                    <p class="text-sm font-semibold {% if paypal.balance >= 0 %}text-green-600{% else %}text-red-600{% endif %}">
                                        {% if paypal.balance is not null %}
                                        {{ paypal.balance|number_format(2, ',', '.') }} {{ paypal.currency|default('Unbekannt') }}
                                        {% else %}Kein Saldo{% endif %}
                                    </p>
                                    {% if paypal.last_sync %}
                                    <p class="text-xs text-gray-500">Stand: {{ date(paypal.last_sync, 'UTC')|date('d.m.Y H:i', 'UTC') }} UTC</p>
                                    {% else %}
                                    <p class="text-xs text-amber-700">Noch nicht synchronisiert</p>
                                    {% endif %}
                                </div>
                                <svg class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                                </svg>
                            </div>
                        </div>
                    </div>
                </a>
            </li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}

    {% if banks|length == 0 and paypal_accounts|length == 0 %}
    <!-- Empty State -->
    <div class="text-center bg-white rounded-lg shadow px-6 py-12">
        <span class="text-6xl mb-4 block">🏦</span>
        <h3 class="mt-2 text-lg font-semibold text-gray-900">Keine Konten verbunden</h3>
        <p class="mt-1 text-sm text-gray-500">Beginnen Sie, indem Sie eine Bankverbindung oder Ihr PayPal-Konto hinzufügen.</p>
        <div class="mt-6 flex justify-center gap-4">
            <a href="/banks/add" class="inline-flex items-center rounded-md bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-primary-500">
                <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
                </svg>
                Bank hinzufügen
            </a>
            <a href="/paypal/add" class="inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500">
                <svg class="-ml-0.5 mr-1.5 h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M7.076 21.337H2.47a.641.641 0 0 1-.633-.74L4.944.901C5.026.382 5.474 0 5.998 0h7.46c2.57 0 4.578.543 5.69 1.81 1.01 1.15 1.304 2.42 1.012 4.287-.023.143-.047.288-.077.437-.983 5.05-4.349 6.797-8.647 6.797h-2.19a.971.971 0 0 0-.958.819l-.007.034-.737 4.669-.008.034a.64.64 0 0 1-.63.45z"/>
                </svg>
                PayPal hinzufügen
            </a>
        </div>
    </div>
    {% endif %}
</div>

<script>
function dashboardSync() {
    return {
        syncing: false,
        results: [],
        currentBankIndex: 0,
        currentBankId: null,
        currentBankName: '',
        totalBanks: 0,
        banks: [{% for bank in banks %}{id: {{ bank.id }}, name: '{{ bank.name|e('js') }}'}{{ not loop.last ? ',' : '' }}{% endfor %}],

        async syncAllBanks() {
            if (this.banks.length === 0) return;
            
            this.syncing = true;
            this.results = [];
            this.totalBanks = this.banks.length;
            this.currentBankIndex = 0;
            
            for (let i = 0; i < this.banks.length; i++) {
                this.currentBankIndex = i;
                const bank = this.banks[i];
                this.currentBankId = bank.id;
                this.currentBankName = bank.name;
                
                try {
                    const result = await this.syncBank(bank);
                    this.results.push(result);
                } catch (error) {
                    this.results.push({
                        bankId: bank.id,
                        bankName: bank.name,
                        success: false,
                        error: true,
                        message: 'Fehler: ' + error.message
                    });
                }
            }
            
            this.syncing = false;
            this.currentBankName = '';
            
            // Keep skipped/error results visible until the user chooses to refresh.
        },

        async syncBank(bank) {
            const response = await fetch(`/api/banks/${bank.id}/sync-all`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await response.json();

            const warning = safeSyncWarning(data);
            if (warning) {
                return { bankId: bank.id, bankName: bank.name, success: false, error: false, message: warning };
            }

            if (response.ok && data.success) {
                const stats = data.stats || {};
                const parts = [];
                if (stats.balances_updated > 0) parts.push(`${stats.balances_updated} Salden`);
                if (stats.transactions_new > 0) parts.push(`${stats.transactions_new} neue TX`);
                if (stats.holdings_updated > 0) parts.push(`${stats.holdings_updated} Wertpapiere`);
                
                return {
                    bankId: bank.id,
                    bankName: bank.name,
                    success: true,
                    error: false,
                    message: (parts.length > 0 ? parts.join(', ') : 'Abruf abgeschlossen') + ' — Seite neu laden, um gespeicherte Daten anzuzeigen.'
                };
            }

            return {
                bankId: bank.id,
                bankName: bank.name,
                success: false,
                error: true,
                message: data.message || 'Unbekannter Fehler'
            };
        },

        clearResults() {
            this.results = [];
        }
    };
}
</script>
{% endblock %}
