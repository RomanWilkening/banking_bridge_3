{% extends "layout.twig" %}

{% block content %}
<div class="space-y-6" x-data="dashboardSync()">
    <!-- Header with Sync All Button -->
    {% if banks|length > 0 %}
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Dashboard</h1>
            <p class="text-sm text-gray-500">Übersicht aller Bankverbindungen</p>
        </div>
        <button @click="syncAllBanks" :disabled="syncing"
                class="inline-flex items-center rounded-md bg-gradient-to-r from-primary-600 to-green-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:from-primary-500 hover:to-green-500 disabled:opacity-50 disabled:cursor-not-allowed">
            <span x-show="syncing" class="loading-spinner mr-2"></span>
            <span x-text="syncing ? 'Synchronisiere...' : '🔄 Alle Banken synchronisieren'"></span>
        </button>
    </div>
    {% endif %}

    <!-- Sync Progress -->
    <div x-show="syncing || results.length > 0" x-cloak class="bg-white shadow rounded-lg p-4">
        <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm font-semibold text-gray-900">Synchronisierungsfortschritt</h3>
            <button x-show="!syncing && results.length > 0" @click="clearResults" class="text-xs text-gray-500 hover:text-gray-700">
                Ausblenden
            </button>
        </div>
        
        <!-- Progress Bar -->
        <div x-show="syncing" class="mb-4">
            <div class="flex justify-between text-xs text-gray-500 mb-1">
                <span x-text="currentBankName || 'Starte...'"></span>
                <span x-text="`${currentBankIndex + 1} / ${totalBanks}`"></span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2">
                <div class="bg-primary-600 h-2 rounded-full transition-all duration-300" 
                     :style="`width: ${totalBanks > 0 ? ((currentBankIndex + 1) / totalBanks * 100) : 0}%`"></div>
            </div>
        </div>

        <!-- Results List -->
        <div class="space-y-2 max-h-60 overflow-y-auto">
            <template x-for="(result, idx) in results" :key="idx">
                <div class="flex items-start gap-3 p-2 rounded-lg" 
                     :class="result.success ? 'bg-green-50' : (result.error ? 'bg-red-50' : 'bg-yellow-50')">
                    <span x-text="result.success ? '✓' : (result.error ? '✗' : '⚠')" 
                          :class="result.success ? 'text-green-600' : (result.error ? 'text-red-600' : 'text-yellow-600')"></span>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium text-gray-900" x-text="result.bankName"></p>
                        <p class="text-xs text-gray-600" x-text="result.message"></p>
                    </div>
                </div>
            </template>
        </div>
    </div>

    <!-- TAN Modal for decoupled -->
    <div x-show="showTanModal" x-cloak class="fixed inset-0 z-50 overflow-y-auto" aria-modal="true">
        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
            <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" @click="cancelCurrentBank"></div>
            <div class="relative transform overflow-hidden rounded-lg bg-white px-4 pb-4 pt-5 text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg sm:p-6">
                <div>
                    <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-yellow-100">
                        <span class="text-2xl">🔐</span>
                    </div>
                    <div class="mt-3 text-center sm:mt-5">
                        <h3 class="text-base font-semibold leading-6 text-gray-900">
                            TAN erforderlich für <span x-text="currentBankName"></span>
                        </h3>
                        <div class="mt-2">
                            <p class="text-sm text-gray-500" x-text="tanRequest?.challenge || 'Bitte bestätigen Sie die Anfrage.'"></p>
                        </div>
                        <div x-show="isDecoupled" class="mt-4">
                            <div class="flex items-center justify-center gap-2 text-sm text-primary-600">
                                <span class="loading-spinner"></span>
                                <span x-text="pollingStatus || 'Warte auf Bestätigung in der Banking-App...'"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mt-5 sm:mt-6 flex gap-3">
                    <button @click="cancelCurrentBank" type="button"
                            class="flex-1 rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
                        Bank überspringen
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
        <div class="bg-white overflow-hidden shadow rounded-lg">
            <div class="p-5">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <span class="text-3xl">🏦</span>
                    </div>
                    <div class="ml-5 w-0 flex-1">
                        <dl>
                            <dt class="text-sm font-medium text-gray-500 truncate">Verbundene Banken</dt>
                            <dd class="text-lg font-semibold text-gray-900">{{ banks|length }}</dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-5 py-3">
                <a href="/banks/add" class="text-sm font-medium text-primary-600 hover:text-primary-500">
                    Bank hinzufügen →
                </a>
            </div>
        </div>

        <div class="bg-white overflow-hidden shadow rounded-lg">
            <div class="p-5">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <span class="text-3xl">💳</span>
                    </div>
                    <div class="ml-5 w-0 flex-1">
                        <dl>
                            <dt class="text-sm font-medium text-gray-500 truncate">Konten gesamt</dt>
                            <dd class="text-lg font-semibold text-gray-900">
                                {% set total_accounts = 0 %}
                                {% for bank in banks %}
                                    {% set total_accounts = total_accounts + bank.account_count %}
                                {% endfor %}
                                {{ total_accounts }}
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-5 py-3">
                <a href="/banks" class="text-sm font-medium text-primary-600 hover:text-primary-500">
                    Alle anzeigen →
                </a>
            </div>
        </div>

        <div class="bg-white overflow-hidden shadow rounded-lg">
            <div class="p-5">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <span class="text-3xl">💰</span>
                    </div>
                    <div class="ml-5 w-0 flex-1">
                        <dl>
                            <dt class="text-sm font-medium text-gray-500 truncate">Gesamtsaldo</dt>
                            <dd class="text-lg font-semibold text-gray-900">
                                {% set total_balance = 0 %}
                                {% for bank in banks %}
                                    {% set total_balance = total_balance + bank.total_balance %}
                                {% endfor %}
                                {{ total_balance|number_format(2, ',', '.') }} €
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-5 py-3">
                <span class="text-sm text-gray-500">Letzter Abruf: -</span>
            </div>
        </div>
    </div>

    <!-- Banks List -->
    {% if banks|length > 0 %}
    <div class="bg-white shadow rounded-lg">
        <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
            <h3 class="text-lg font-medium leading-6 text-gray-900">Ihre Bankverbindungen</h3>
        </div>
        <ul role="list" class="divide-y divide-gray-200">
            {% for bank in banks %}
            <li>
                <a href="/banks/{{ bank.id }}" class="block hover:bg-gray-50">
                    <div class="px-4 py-4 sm:px-6">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center">
                                <div class="flex-shrink-0">
                                    <span class="inline-flex items-center justify-center h-12 w-12 rounded-full bg-primary-100">
                                        <span class="text-xl">🏦</span>
                                    </span>
                                </div>
                                <div class="ml-4">
                                    <p class="text-sm font-medium text-primary-600">{{ bank.name }}</p>
                                    <p class="text-sm text-gray-500">BLZ: {{ bank.bank_code }}</p>
                                </div>
                            </div>
                            <div class="flex items-center space-x-4">
                                <div class="text-right">
                                    <p class="text-sm font-semibold text-gray-900">{{ bank.total_balance|number_format(2, ',', '.') }} €</p>
                                    <p class="text-sm text-gray-500">{{ bank.account_count }} Konto(en)</p>
                                </div>
                                <svg class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                                </svg>
                            </div>
                        </div>
                    </div>
                </a>
            </li>
            {% endfor %}
        </ul>
    </div>
    {% else %}
    <!-- Empty State -->
    <div class="text-center bg-white rounded-lg shadow px-6 py-12">
        <span class="text-6xl mb-4 block">🏦</span>
        <h3 class="mt-2 text-lg font-semibold text-gray-900">Keine Banken verbunden</h3>
        <p class="mt-1 text-sm text-gray-500">Beginnen Sie, indem Sie Ihre erste Bankverbindung hinzufügen.</p>
        <div class="mt-6">
            <a href="/banks/add" class="inline-flex items-center rounded-md bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-primary-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">
                <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
                </svg>
                Bank hinzufügen
            </a>
        </div>
    </div>
    {% endif %}
</div>

<script>
function dashboardSync() {
    return {
        syncing: false,
        results: [],
        currentBankIndex: 0,
        currentBankId: null,
        currentBankName: '',
        totalBanks: 0,
        showTanModal: false,
        tanRequest: null,
        isDecoupled: false,
        pollingInterval: null,
        pollingStatus: '',
        banks: {{ banks|json_encode|raw }},

        async syncAllBanks() {
            if (this.banks.length === 0) return;
            
            this.syncing = true;
            this.results = [];
            this.totalBanks = this.banks.length;
            this.currentBankIndex = 0;
            
            for (let i = 0; i < this.banks.length; i++) {
                this.currentBankIndex = i;
                const bank = this.banks[i];
                this.currentBankId = bank.id;
                this.currentBankName = bank.name;
                
                try {
                    const result = await this.syncBank(bank);
                    this.results.push(result);
                } catch (error) {
                    this.results.push({
                        bankName: bank.name,
                        success: false,
                        error: true,
                        message: 'Fehler: ' + error.message
                    });
                }
            }
            
            this.syncing = false;
            this.currentBankName = '';
            
            // Reload after 3 seconds to show updated data
            setTimeout(() => location.reload(), 3000);
        },

        async syncBank(bank) {
            const response = await fetch(`/api/banks/${bank.id}/sync-all`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await response.json();

            if (data.needs_tan) {
                this.tanRequest = data.tan_request;
                this.isDecoupled = data.tan_request?.is_decoupled || false;
                this.showTanModal = true;
                
                if (this.isDecoupled) {
                    this.pollingStatus = 'Bitte bestätigen Sie die Anfrage in der Banking-App...';
                    return await this.waitForDecoupledTan(bank);
                } else {
                    // For non-decoupled TAN, skip this bank (can't input TAN in batch mode)
                    this.showTanModal = false;
                    return {
                        bankName: bank.name,
                        success: false,
                        error: false,
                        message: 'TAN erforderlich - bitte einzeln synchronisieren'
                    };
                }
            }

            if (data.success) {
                const stats = data.stats;
                const parts = [];
                if (stats.balances_updated > 0) parts.push(`${stats.balances_updated} Salden`);
                if (stats.transactions_new > 0) parts.push(`${stats.transactions_new} neue TX`);
                if (stats.holdings_updated > 0) parts.push(`${stats.holdings_updated} Wertpapiere`);
                
                return {
                    bankName: bank.name,
                    success: true,
                    error: false,
                    message: parts.length > 0 ? parts.join(', ') : 'Alles aktuell'
                };
            }

            return {
                bankName: bank.name,
                success: false,
                error: true,
                message: data.message || 'Unbekannter Fehler'
            };
        },

        async waitForDecoupledTan(bank) {
            return new Promise((resolve) => {
                // Store resolve function so cancelCurrentBank can call it
                this._currentResolve = resolve;
                this._currentBank = bank;
                
                this.pollingInterval = setInterval(async () => {
                    try {
                        const response = await fetch(`/api/banks/${bank.id}/decoupled`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' }
                        });
                        const data = await response.json();

                        if (data.status === 'pending') {
                            this.pollingStatus = 'Warte auf Bestätigung...';
                        } else if (data.success) {
                            this.stopPolling();
                            this.showTanModal = false;
                            this._currentResolve = null;
                            
                            if (data.stats) {
                                const stats = data.stats;
                                const parts = [];
                                if (stats.balances_updated > 0) parts.push(`${stats.balances_updated} Salden`);
                                if (stats.transactions_new > 0) parts.push(`${stats.transactions_new} neue TX`);
                                if (stats.holdings_updated > 0) parts.push(`${stats.holdings_updated} Wertpapiere`);
                                
                                resolve({
                                    bankName: bank.name,
                                    success: true,
                                    error: false,
                                    message: parts.length > 0 ? parts.join(', ') : 'Alles aktuell'
                                });
                            } else {
                                resolve({
                                    bankName: bank.name,
                                    success: true,
                                    error: false,
                                    message: data.message || 'Synchronisiert'
                                });
                            }
                        } else if (data.needs_tan) {
                            // Another TAN needed, wait more
                            this.tanRequest = data.tan_request;
                            this.isDecoupled = data.tan_request?.is_decoupled || false;
                        } else {
                            this.stopPolling();
                            this.showTanModal = false;
                            this._currentResolve = null;
                            resolve({
                                bankName: bank.name,
                                success: false,
                                error: true,
                                message: data.message || 'Fehler bei TAN-Bestätigung'
                            });
                        }
                    } catch (error) {
                        console.error('Polling error:', error);
                    }
                }, 3000);
            });
        },

        stopPolling() {
            if (this.pollingInterval) {
                clearInterval(this.pollingInterval);
                this.pollingInterval = null;
            }
        },

        cancelCurrentBank() {
            this.stopPolling();
            this.showTanModal = false;
            
            // Resolve the pending promise to continue with next bank
            if (this._currentResolve && this._currentBank) {
                this._currentResolve({
                    bankName: this._currentBank.name,
                    success: false,
                    error: false,
                    message: 'Übersprungen'
                });
                this._currentResolve = null;
                this._currentBank = null;
            }
        },

        clearResults() {
            this.results = [];
        }
    };
}
</script>
{% endblock %}
