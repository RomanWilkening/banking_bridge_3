{% extends "layout.twig" %}

{% block content %}
<div class="space-y-6">
    <!-- Quick Stats -->
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        <div class="bg-white overflow-hidden shadow rounded-lg">
            <div class="p-5">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <span class="text-3xl">🏦</span>
                    </div>
                    <div class="ml-5 w-0 flex-1">
                        <dl>
                            <dt class="text-sm font-medium text-gray-500 truncate">Verbundene Banken</dt>
                            <dd class="text-lg font-semibold text-gray-900">{{ banks|length }}</dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-5 py-3">
                <a href="/banks/add" class="text-sm font-medium text-primary-600 hover:text-primary-500">
                    Bank hinzufügen →
                </a>
            </div>
        </div>

        <div class="bg-white overflow-hidden shadow rounded-lg">
            <div class="p-5">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <span class="text-3xl">💳</span>
                    </div>
                    <div class="ml-5 w-0 flex-1">
                        <dl>
                            <dt class="text-sm font-medium text-gray-500 truncate">Konten gesamt</dt>
                            <dd class="text-lg font-semibold text-gray-900">
                                {% set total_accounts = 0 %}
                                {% for bank in banks %}
                                    {% set total_accounts = total_accounts + bank.account_count %}
                                {% endfor %}
                                {{ total_accounts }}
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-5 py-3">
                <a href="/banks" class="text-sm font-medium text-primary-600 hover:text-primary-500">
                    Alle anzeigen →
                </a>
            </div>
        </div>

        <div class="bg-white overflow-hidden shadow rounded-lg">
            <div class="p-5">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <span class="text-3xl">💰</span>
                    </div>
                    <div class="ml-5 w-0 flex-1">
                        <dl>
                            <dt class="text-sm font-medium text-gray-500 truncate">Gesamtsaldo</dt>
                            <dd class="text-lg font-semibold text-gray-900">
                                {% set total_balance = 0 %}
                                {% for bank in banks %}
                                    {% set total_balance = total_balance + bank.total_balance %}
                                {% endfor %}
                                {{ total_balance|number_format(2, ',', '.') }} €
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-5 py-3">
                <span class="text-sm text-gray-500">Letzter Abruf: -</span>
            </div>
        </div>
    </div>

    <!-- Banks List -->
    {% if banks|length > 0 %}
    <div class="bg-white shadow rounded-lg">
        <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
            <h3 class="text-lg font-medium leading-6 text-gray-900">Ihre Bankverbindungen</h3>
        </div>
        <ul role="list" class="divide-y divide-gray-200">
            {% for bank in banks %}
            <li>
                <a href="/banks/{{ bank.id }}" class="block hover:bg-gray-50">
                    <div class="px-4 py-4 sm:px-6">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center">
                                <div class="flex-shrink-0">
                                    <span class="inline-flex items-center justify-center h-12 w-12 rounded-full bg-primary-100">
                                        <span class="text-xl">🏦</span>
                                    </span>
                                </div>
                                <div class="ml-4">
                                    <p class="text-sm font-medium text-primary-600">{{ bank.name }}</p>
                                    <p class="text-sm text-gray-500">BLZ: {{ bank.bank_code }}</p>
                                </div>
                            </div>
                            <div class="flex items-center space-x-4">
                                <div class="text-right">
                                    <p class="text-sm font-semibold text-gray-900">{{ bank.total_balance|number_format(2, ',', '.') }} €</p>
                                    <p class="text-sm text-gray-500">{{ bank.account_count }} Konto(en)</p>
                                </div>
                                <svg class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                                </svg>
                            </div>
                        </div>
                    </div>
                </a>
            </li>
            {% endfor %}
        </ul>
    </div>
    {% else %}
    <!-- Empty State -->
    <div class="text-center bg-white rounded-lg shadow px-6 py-12">
        <span class="text-6xl mb-4 block">🏦</span>
        <h3 class="mt-2 text-lg font-semibold text-gray-900">Keine Banken verbunden</h3>
        <p class="mt-1 text-sm text-gray-500">Beginnen Sie, indem Sie Ihre erste Bankverbindung hinzufügen.</p>
        <div class="mt-6">
            <a href="/banks/add" class="inline-flex items-center rounded-md bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-primary-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">
                <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
                </svg>
                Bank hinzufügen
            </a>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
