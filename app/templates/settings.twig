{% extends "layout.twig" %}

{% block content %}
<div class="max-w-2xl mx-auto space-y-6">
    
    {% if success %}
    <div class="rounded-md bg-green-50 p-4">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                </svg>
            </div>
            <div class="ml-3">
                <p class="text-sm font-medium text-green-800">Einstellungen erfolgreich gespeichert!</p>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Cron Job Status Monitor -->
    <div class="bg-white shadow rounded-lg mb-6" x-data="cronMonitor()" x-init="init()">
        <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
            <div class="flex justify-between items-center">
                <div>
                    <h3 class="text-lg font-medium leading-6 text-gray-900">Hintergrund-Jobs Status</h3>
                    <p class="mt-1 text-sm text-gray-500">Übersicht der automatischen Prozesse</p>
                </div>
                <button @click="refresh()" :disabled="loading" class="text-gray-400 hover:text-gray-600">
                    <svg class="h-5 w-5" :class="loading ? 'animate-spin' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                </button>
            </div>
        </div>
        <div class="px-4 py-5 sm:p-6">
            <!-- Cron Daemon Status -->
            <div class="flex items-center justify-between mb-4 pb-4 border-b border-gray-100">
                <span class="text-sm font-medium text-gray-700">Cron-Daemon</span>
                <div class="flex items-center gap-2">
                    <span class="text-sm" :class="cronRunning ? 'text-green-600' : 'text-red-600'" x-text="cronRunning ? 'Läuft' : 'Gestoppt'"></span>
                    <span class="flex h-2 w-2 relative">
                        <span x-show="cronRunning" class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75" :class="cronRunning ? 'bg-green-400' : 'bg-red-400'"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2" :class="cronRunning ? 'bg-green-500' : 'bg-red-500'"></span>
                    </span>
                </div>
            </div>

            <!-- Auto-Sync Status -->
            <div class="mb-4 pb-4 border-b border-gray-100">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-sm font-medium text-gray-700">Auto-Sync</span>
                    <div class="flex items-center gap-2">
                        <span class="text-xs px-2 py-0.5 rounded-full" 
                              :class="autoSync.enabled ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-600'"
                              x-text="autoSync.enabled ? 'Aktiviert' : 'Deaktiviert'"></span>
                        <span x-show="autoSync.lastStatus" class="text-xs px-2 py-0.5 rounded-full"
                              :class="{
                                  'bg-green-100 text-green-800': autoSync.lastStatus === 'success',
                                  'bg-yellow-100 text-yellow-800': autoSync.lastStatus === 'partial',
                                  'bg-red-100 text-red-800': autoSync.lastStatus === 'error'
                              }"
                              x-text="autoSync.lastStatus === 'success' ? 'OK' : (autoSync.lastStatus === 'partial' ? 'Teilweise' : 'Fehler')"></span>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4 text-sm">
                    <div>
                        <span class="text-gray-500">Letzter Lauf:</span>
                        <span class="ml-1 text-gray-900" x-text="autoSync.lastRun || 'Noch nie'"></span>
                    </div>
                    <div>
                        <span class="text-gray-500">Intervall:</span>
                        <span class="ml-1 text-gray-900" x-text="autoSync.interval + ' Min.'"></span>
                    </div>
                </div>
                <div x-show="autoSync.lastError" class="mt-2 text-xs text-red-600" x-text="autoSync.lastError"></div>
            </div>

            <!-- MQTT Publish Status -->
            <div>
                <div class="flex items-center justify-between mb-2">
                    <span class="text-sm font-medium text-gray-700">MQTT Auto-Publish</span>
                    <div class="flex items-center gap-2">
                        <span class="text-xs px-2 py-0.5 rounded-full" 
                              :class="mqtt.enabled ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-600'"
                              x-text="mqtt.enabled ? 'Aktiviert' : 'Deaktiviert'"></span>
                        <span x-show="mqtt.lastStatus" class="text-xs px-2 py-0.5 rounded-full"
                              :class="{
                                  'bg-green-100 text-green-800': mqtt.lastStatus === 'success',
                                  'bg-red-100 text-red-800': mqtt.lastStatus === 'error'
                              }"
                              x-text="mqtt.lastStatus === 'success' ? 'OK' : 'Fehler'"></span>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4 text-sm">
                    <div>
                        <span class="text-gray-500">Letzter Lauf:</span>
                        <span class="ml-1 text-gray-900" x-text="mqtt.lastRun || 'Noch nie'"></span>
                    </div>
                    <div>
                        <span class="text-gray-500">Intervall:</span>
                        <span class="ml-1 text-gray-900" x-text="mqtt.interval + ' Min.'"></span>
                    </div>
                </div>
                <div x-show="mqtt.lastError" class="mt-2 text-xs text-red-600" x-text="mqtt.lastError"></div>
            </div>

            <!-- Server Time -->
            <div class="mt-4 pt-4 border-t border-gray-100 text-xs text-gray-400 text-right">
                Server-Zeit: <span x-text="serverTime"></span>
                <span class="ml-2">(Auto-Refresh alle 30s)</span>
            </div>
        </div>
    </div>

    <form method="POST" action="/settings">
        <!-- FinTS Settings -->
        <div class="bg-white shadow rounded-lg mb-6">
            <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
                <h3 class="text-lg font-medium leading-6 text-gray-900">FinTS-Einstellungen</h3>
                <p class="mt-1 text-sm text-gray-500">Konfiguration für die Bankverbindung</p>
            </div>
            <div class="px-4 py-5 sm:p-6 space-y-6">
                <div>
                    <label for="fints_product_id" class="block text-sm font-medium text-gray-700">FinTS Produkt-ID *</label>
                    <input type="text" name="fints_product_id" id="fints_product_id"
                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm border px-3 py-2"
                           placeholder="z.B. 1234567890ABCDEF1234567890ABCDEF"
                           value="{{ settings.fints_product_id }}" required>
                    <p class="mt-2 text-sm text-gray-500">
                        Die FinTS Produkt-ID muss bei der Deutschen Kreditwirtschaft registriert sein.
                    </p>
                    <div class="mt-2 p-3 bg-blue-50 rounded-md">
                        <p class="text-sm text-blue-800">
                            <strong>So erhalten Sie eine Produkt-ID:</strong><br>
                            1. Registrieren Sie sich unter <a href="https://www.hbci-zka.de/register/prod_register.htm" target="_blank" class="underline">hbci-zka.de</a><br>
                            2. Die Registrierung ist kostenlos für nicht-kommerzielle Nutzung<br>
                            3. Sie erhalten die ID per E-Mail
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Auto Sync Settings -->
        <div class="bg-white shadow rounded-lg mb-6" x-data="autoSyncSettings()">
            <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
                <h3 class="text-lg font-medium leading-6 text-gray-900">Automatische Synchronisierung</h3>
                <p class="mt-1 text-sm text-gray-500">Bankdaten automatisch im Hintergrund aktualisieren</p>
            </div>
            <div class="px-4 py-5 sm:p-6 space-y-6">
                <div class="flex items-center justify-between">
                    <div class="flex items-center">
                        <input type="checkbox" name="auto_sync_enabled" id="auto_sync_enabled"
                               class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500"
                               {{ settings.auto_sync_enabled == '1' ? 'checked' : '' }}
                               x-model="enabled">
                        <label for="auto_sync_enabled" class="ml-3 block text-sm font-medium text-gray-700">
                            Automatische Synchronisierung aktivieren
                        </label>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-sm" :class="status === 'running' ? 'text-green-600' : 'text-gray-500'" x-text="statusText"></span>
                        <span x-show="status === 'running'" class="flex h-2 w-2 relative">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
                        </span>
                    </div>
                </div>
                
                <div>
                    <label for="auto_sync_interval" class="block text-sm font-medium text-gray-700">Synchronisierungs-Intervall</label>
                    <select name="auto_sync_interval" id="auto_sync_interval"
                            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm border px-3 py-2">
                        <option value="15" {{ settings.auto_sync_interval == '15' ? 'selected' : '' }}>Alle 15 Minuten</option>
                        <option value="30" {{ settings.auto_sync_interval == '30' or settings.auto_sync_interval == '' ? 'selected' : '' }}>Alle 30 Minuten</option>
                        <option value="60" {{ settings.auto_sync_interval == '60' ? 'selected' : '' }}>Stündlich</option>
                        <option value="120" {{ settings.auto_sync_interval == '120' ? 'selected' : '' }}>Alle 2 Stunden</option>
                        <option value="360" {{ settings.auto_sync_interval == '360' ? 'selected' : '' }}>Alle 6 Stunden</option>
                        <option value="720" {{ settings.auto_sync_interval == '720' ? 'selected' : '' }}>Alle 12 Stunden</option>
                        <option value="1440" {{ settings.auto_sync_interval == '1440' ? 'selected' : '' }}>Täglich</option>
                    </select>
                </div>

                <div class="bg-yellow-50 p-3 rounded-md">
                    <p class="text-sm text-yellow-800">
                        <strong>⚠️ Hinweis:</strong> Die automatische Synchronisierung funktioniert nur für Banken, 
                        die nach der ersten manuellen Authentifizierung keine weitere TAN benötigen. 
                        Banken die eine TAN verlangen werden übersprungen und im Aktivitätsprotokoll vermerkt.
                    </p>
                </div>

                <div class="flex items-center gap-4 pt-2">
                    <button type="button" @click="runNow" :disabled="syncing"
                            class="inline-flex items-center rounded-md bg-green-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-500 disabled:opacity-50">
                        <span x-show="syncing" class="loading-spinner mr-2"></span>
                        <span x-text="syncing ? 'Synchronisiere...' : '▶ Jetzt synchronisieren'"></span>
                    </button>
                    <div x-show="lastSync" class="text-sm text-gray-500">
                        Letzte Ausführung: <span x-text="lastSync"></span>
                    </div>
                </div>

                <div x-show="message" x-cloak class="rounded-md p-3" :class="messageType === 'success' ? 'bg-green-50' : 'bg-red-50'">
                    <p class="text-sm" :class="messageType === 'success' ? 'text-green-800' : 'text-red-800'" x-text="message"></p>
                </div>
            </div>
        </div>

        <!-- MQTT Settings -->
        <div class="bg-white shadow rounded-lg mb-6" x-data="mqttSettings()">
            <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
                <h3 class="text-lg font-medium leading-6 text-gray-900">MQTT-Einstellungen</h3>
                <p class="mt-1 text-sm text-gray-500">Konfiguration für Home Assistant Integration</p>
            </div>
            <div class="px-4 py-5 sm:p-6 space-y-6">
                <div class="flex items-center">
                    <input type="checkbox" name="mqtt_enabled" id="mqtt_enabled"
                           class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500"
                           {{ settings.mqtt_enabled == '1' ? 'checked' : '' }}
                           x-model="enabled">
                    <label for="mqtt_enabled" class="ml-3 block text-sm font-medium text-gray-700">
                        MQTT-Übertragung aktivieren
                    </label>
                </div>
                
                <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                    <div>
                        <label for="mqtt_host" class="block text-sm font-medium text-gray-700">MQTT Host *</label>
                        <input type="text" name="mqtt_host" id="mqtt_host"
                               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm border px-3 py-2"
                               placeholder="homeassistant.local"
                               value="{{ settings.mqtt_host }}">
                    </div>
                    <div>
                        <label for="mqtt_port" class="block text-sm font-medium text-gray-700">MQTT Port</label>
                        <input type="number" name="mqtt_port" id="mqtt_port"
                               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm border px-3 py-2"
                               placeholder="1883"
                               value="{{ settings.mqtt_port }}">
                    </div>
                </div>
                <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                    <div>
                        <label for="mqtt_user" class="block text-sm font-medium text-gray-700">MQTT Benutzer</label>
                        <input type="text" name="mqtt_user" id="mqtt_user"
                               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm border px-3 py-2"
                               placeholder="mqtt_user"
                               value="{{ settings.mqtt_user }}">
                    </div>
                    <div>
                        <label for="mqtt_password" class="block text-sm font-medium text-gray-700">MQTT Passwort</label>
                        <input type="password" name="mqtt_password" id="mqtt_password"
                               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm border px-3 py-2"
                               placeholder="••••••••"
                               value="{{ settings.mqtt_password }}">
                    </div>
                </div>
                <div>
                    <label for="mqtt_topic_prefix" class="block text-sm font-medium text-gray-700">MQTT Topic Präfix</label>
                    <input type="text" name="mqtt_topic_prefix" id="mqtt_topic_prefix"
                           class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm border px-3 py-2"
                           placeholder="banking"
                           value="{{ settings.mqtt_topic_prefix }}">
                    <p class="mt-1 text-sm text-gray-500">
                        Topics werden als <code class="bg-gray-100 px-1 rounded">{{ settings.mqtt_topic_prefix ?: 'banking' }}/bankname/kontoname</code> veröffentlicht
                    </p>
                </div>
                
                <div class="bg-blue-50 p-3 rounded-md">
                    <p class="text-sm text-blue-800">
                        <strong>Home Assistant Auto-Discovery:</strong> Aktivierte Konten werden automatisch als Sensoren in Home Assistant erkannt. 
                        Gehen Sie zur jeweiligen Bank, um einzelne Konten für MQTT zu aktivieren.
                    </p>
                </div>

                <!-- Auto-Publish Settings -->
                <div class="border-t border-gray-200 pt-6 mt-6">
                    <h4 class="text-md font-medium text-gray-900 mb-4">Automatische Updates</h4>
                    
                    <div class="flex items-center justify-between mb-4">
                        <div class="flex items-center">
                            <input type="checkbox" name="mqtt_auto_publish_enabled" id="mqtt_auto_publish_enabled"
                                   class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500"
                                   {{ settings.mqtt_auto_publish_enabled == '1' ? 'checked' : '' }}
                                   x-model="autoPublishEnabled">
                            <label for="mqtt_auto_publish_enabled" class="ml-3 block text-sm font-medium text-gray-700">
                                Automatisch MQTT-Updates senden
                            </label>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-sm" :class="autoPublishEnabled ? 'text-green-600' : 'text-gray-500'" x-text="autoPublishEnabled ? 'Aktiv' : 'Inaktiv'"></span>
                            <span x-show="autoPublishEnabled" class="flex h-2 w-2 relative">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
                            </span>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <label for="mqtt_auto_publish_interval" class="block text-sm font-medium text-gray-700">Update-Intervall</label>
                        <select name="mqtt_auto_publish_interval" id="mqtt_auto_publish_interval"
                                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm border px-3 py-2">
                            <option value="1" {{ settings.mqtt_auto_publish_interval == '1' or settings.mqtt_auto_publish_interval == '' ? 'selected' : '' }}>Jede Minute</option>
                            <option value="5" {{ settings.mqtt_auto_publish_interval == '5' ? 'selected' : '' }}>Alle 5 Minuten</option>
                            <option value="10" {{ settings.mqtt_auto_publish_interval == '10' ? 'selected' : '' }}>Alle 10 Minuten</option>
                            <option value="15" {{ settings.mqtt_auto_publish_interval == '15' ? 'selected' : '' }}>Alle 15 Minuten</option>
                            <option value="30" {{ settings.mqtt_auto_publish_interval == '30' ? 'selected' : '' }}>Alle 30 Minuten</option>
                            <option value="60" {{ settings.mqtt_auto_publish_interval == '60' ? 'selected' : '' }}>Stündlich</option>
                        </select>
                        <p class="mt-1 text-sm text-gray-500">
                            Sendet automatisch die aktuellen Kontostände an den MQTT-Broker.
                        </p>
                    </div>

                    <div x-show="lastPublish" class="text-sm text-gray-500 mb-4">
                        Letzte MQTT-Übertragung: <span x-text="lastPublish"></span>
                    </div>
                </div>

                <div class="flex items-center gap-4 pt-2">
                    <button type="button" @click="testConnection" :disabled="testing"
                            class="inline-flex items-center rounded-md bg-gray-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-gray-500 disabled:opacity-50">
                        <span x-show="testing" class="loading-spinner mr-2"></span>
                        <span x-text="testing ? 'Teste...' : 'Verbindung testen'"></span>
                    </button>
                    <button type="button" @click="publishNow" :disabled="publishing"
                            class="inline-flex items-center rounded-md bg-green-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-500 disabled:opacity-50">
                        <span x-show="publishing" class="loading-spinner mr-2"></span>
                        <span x-text="publishing ? 'Sende...' : 'Jetzt senden'"></span>
                    </button>
                </div>

                <div x-show="mqttMessage" x-cloak class="rounded-md p-3" :class="mqttMessageType === 'success' ? 'bg-green-50' : 'bg-red-50'">
                    <p class="text-sm" :class="mqttMessageType === 'success' ? 'text-green-800' : 'text-red-800'" x-text="mqttMessage"></p>
                </div>
            </div>
        </div>

        <div class="flex justify-end space-x-3">
            <a href="/" class="inline-flex items-center rounded-md bg-white px-4 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
                Abbrechen
            </a>
            <button type="submit"
                    class="inline-flex items-center rounded-md bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-primary-500">
                Speichern
            </button>
        </div>
    </form>
</div>

<script>
function cronMonitor() {
    return {
        loading: false,
        cronRunning: false,
        serverTime: '',
        autoSync: {
            enabled: false,
            interval: 30,
            lastRun: '',
            lastStatus: '',
            lastError: ''
        },
        mqtt: {
            enabled: false,
            interval: 1,
            lastRun: '',
            lastStatus: '',
            lastError: ''
        },
        refreshInterval: null,

        async init() {
            await this.refresh();
            // Auto-refresh every 30 seconds
            this.refreshInterval = setInterval(() => this.refresh(), 30000);
        },

        async refresh() {
            this.loading = true;
            try {
                const response = await fetch('/api/cron/status');
                const data = await response.json();
                
                if (data.success) {
                    this.cronRunning = data.cron_daemon_running;
                    this.serverTime = data.server_time;
                    
                    this.autoSync = {
                        enabled: data.auto_sync.enabled,
                        interval: data.auto_sync.interval_minutes,
                        lastRun: data.auto_sync.last_run,
                        lastStatus: data.auto_sync.last_status,
                        lastError: data.auto_sync.last_error
                    };
                    
                    this.mqtt = {
                        enabled: data.mqtt_publish.enabled,
                        interval: data.mqtt_publish.interval_minutes,
                        lastRun: data.mqtt_publish.last_run,
                        lastStatus: data.mqtt_publish.last_status,
                        lastError: data.mqtt_publish.last_error
                    };
                }
            } catch (error) {
                console.error('Failed to fetch cron status:', error);
            }
            this.loading = false;
        },

        destroy() {
            if (this.refreshInterval) {
                clearInterval(this.refreshInterval);
            }
        }
    };
}

function autoSyncSettings() {
    return {
        enabled: {{ settings.auto_sync_enabled == '1' ? 'true' : 'false' }},
        status: '{{ settings.auto_sync_enabled == "1" ? "running" : "stopped" }}',
        statusText: '{{ settings.auto_sync_enabled == "1" ? "Aktiv" : "Inaktiv" }}',
        syncing: false,
        message: '',
        messageType: 'success',
        lastSync: '{{ settings.auto_sync_last_run ?? "" }}',

        async runNow() {
            this.syncing = true;
            this.message = '';

            try {
                const response = await fetch('/api/auto-sync/run', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();

                if (data.success) {
                    this.message = data.message;
                    this.messageType = 'success';
                    this.lastSync = new Date().toLocaleString('de-DE');
                } else {
                    this.message = data.message || 'Synchronisierung fehlgeschlagen';
                    this.messageType = 'error';
                }
            } catch (error) {
                this.message = 'Netzwerkfehler: ' + error.message;
                this.messageType = 'error';
            }

            this.syncing = false;
        },

        init() {
            this.$watch('enabled', (value) => {
                this.status = value ? 'running' : 'stopped';
                this.statusText = value ? 'Aktiv' : 'Inaktiv';
            });
        }
    };
}

function mqttSettings() {
    return {
        enabled: {{ settings.mqtt_enabled == '1' ? 'true' : 'false' }},
        autoPublishEnabled: {{ settings.mqtt_auto_publish_enabled == '1' ? 'true' : 'false' }},
        lastPublish: '{{ settings.mqtt_last_publish ?? "" }}',
        testing: false,
        publishing: false,
        mqttMessage: '',
        mqttMessageType: 'success',

        async testConnection() {
            this.testing = true;
            this.mqttMessage = '';

            try {
                const response = await fetch('/api/mqtt/test', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();

                this.mqttMessage = data.message;
                this.mqttMessageType = data.success ? 'success' : 'error';
            } catch (error) {
                this.mqttMessage = 'Netzwerkfehler: ' + error.message;
                this.mqttMessageType = 'error';
            }

            this.testing = false;
        },

        async publishNow() {
            this.publishing = true;
            this.mqttMessage = '';

            try {
                const response = await fetch('/api/mqtt/publish', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();

                this.mqttMessage = data.message;
                this.mqttMessageType = data.success ? 'success' : 'error';
            } catch (error) {
                this.mqttMessage = 'Netzwerkfehler: ' + error.message;
                this.mqttMessageType = 'error';
            }

            this.publishing = false;
        }
    };
}
</script>
{% endblock %}
