{% extends "layout.twig" %}

{% block content %}
<div x-data="bankDetails({{ bank.id }})" class="space-y-6">
    <!-- Bank Info Card -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
        <div class="px-4 py-5 sm:px-6 flex justify-between items-center border-b border-gray-200">
            <div class="flex items-center">
                <span class="inline-flex items-center justify-center h-14 w-14 rounded-full bg-primary-100">
                    <span class="text-2xl">🏦</span>
                </span>
                <div class="ml-4" x-data="editableName('bank', {{ bank.id }}, '{{ bank.name|e('js') }}')">
                    <div class="flex items-center gap-2">
                        <h3 x-show="!editing" class="text-lg font-medium text-gray-900" x-text="displayName"></h3>
                        <input x-show="editing" x-model="editName" @keyup.enter="save" @keyup.escape="cancel"
                               x-ref="nameInput" type="text"
                               class="text-lg font-medium text-gray-900 border-b border-primary-500 focus:outline-none bg-transparent">
                        <button x-show="!editing" @click="edit" class="text-gray-400 hover:text-primary-500" title="Umbenennen">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
                            </svg>
                        </button>
                        <button x-show="editing" @click="save" class="text-green-500 hover:text-green-600" title="Speichern">✓</button>
                        <button x-show="editing" @click="cancel" class="text-red-500 hover:text-red-600" title="Abbrechen">✕</button>
                    </div>
                    <p class="text-sm text-gray-500">BLZ: {{ bank.bank_code }}</p>
                </div>
            </div>
            <div class="flex flex-wrap gap-2">
                <button @click="syncAll" :disabled="syncingAll"
                        class="inline-flex items-center rounded-md bg-gradient-to-r from-primary-600 to-green-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:from-primary-500 hover:to-green-500 disabled:opacity-50">
                    <span x-show="syncingAll" class="loading-spinner mr-2"></span>
                    <span x-text="syncingAll ? 'Synchronisiere...' : '🔄 Alles synchronisieren'"></span>
                </button>
                <button @click="fetchAccounts" :disabled="loading"
                        class="inline-flex items-center rounded-md bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-primary-500 disabled:opacity-50">
                    <span x-show="loading" class="loading-spinner mr-2"></span>
                    <span x-text="loading ? 'Lade...' : 'Konten abrufen'"></span>
                </button>
                <button @click="syncBalances" :disabled="syncingBalances"
                        class="inline-flex items-center rounded-md bg-green-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-500 disabled:opacity-50">
                    <span x-show="syncingBalances" class="loading-spinner mr-2"></span>
                    <span x-text="syncingBalances ? 'Lade...' : 'Salden aktualisieren'"></span>
                </button>
                <button @click="resetSession" :disabled="resettingSession"
                        class="inline-flex items-center rounded-md bg-yellow-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-yellow-500 disabled:opacity-50"
                        title="Löscht die gespeicherte Session und erzwingt eine neue Verbindung">
                    <span x-show="resettingSession" class="loading-spinner mr-2"></span>
                    <span x-text="resettingSession ? 'Setze zurück...' : 'Session zurücksetzen'"></span>
                </button>
                <form method="POST" action="/banks/{{ bank.id }}/delete" 
                      onsubmit="return confirm('Sind Sie sicher, dass Sie diese Bankverbindung löschen möchten?');">
                    <button type="submit" class="inline-flex items-center rounded-md bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500">
                        Löschen
                    </button>
                </form>
            </div>
        </div>
        
        <div class="px-4 py-5 sm:px-6">
            <dl class="grid grid-cols-1 gap-x-4 gap-y-4 sm:grid-cols-2">
                <div>
                    <dt class="text-sm font-medium text-gray-500">FinTS-URL</dt>
                    <dd class="mt-1 text-sm text-gray-900 break-all">{{ bank.fints_url }}</dd>
                </div>
                <div>
                    <dt class="text-sm font-medium text-gray-500">Benutzer</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ bank.username }}</dd>
                </div>
                <div>
                    <dt class="text-sm font-medium text-gray-500">Erstellt am</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ bank.created_at|date('d.m.Y H:i') }}</dd>
                </div>
                <div>
                    <dt class="text-sm font-medium text-gray-500">Aktualisiert am</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ bank.updated_at|date('d.m.Y H:i') }}</dd>
                </div>
            </dl>
        </div>
    </div>

    <!-- TAN Session Validity Card -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
        <div class="px-4 py-4 sm:px-6 border-b border-gray-200">
            <h3 class="text-lg font-medium leading-6 text-gray-900">
                <span class="mr-2">🔐</span> TAN-Session / Authentifizierung
            </h3>
            <p class="mt-1 text-sm text-gray-500">Status der starken Kundenauthentifizierung (PSD2 SCA)</p>
        </div>
        <div class="px-4 py-4 sm:px-6">
            {% if tan_session %}
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-500">Status</span>
                    {% if tan_session.is_valid %}
                    <span class="inline-flex items-center rounded-full bg-green-100 px-3 py-1 text-sm font-medium text-green-800">✓ Aktiv</span>
                    {% else %}
                    <span class="inline-flex items-center rounded-full bg-red-100 px-3 py-1 text-sm font-medium text-red-800">✗ Abgelaufen</span>
                    {% endif %}
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-500">Letzte TAN-Bestätigung</span>
                    <span class="text-sm text-gray-900">{{ tan_session.created_at }}</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-500">Gültig bis</span>
                    <span class="text-sm text-gray-900">{{ tan_session.expires_at }}</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-500">Verbleibend</span>
                    <span class="text-sm font-medium {% if tan_session.remaining_days > 14 %}text-green-600{% elseif tan_session.remaining_days > 3 %}text-yellow-600{% else %}text-red-600{% endif %}">
                        {{ tan_session.remaining_days }} Tage
                    </span>
                </div>
                {% if tan_session.tan_mode %}
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-500">TAN-Verfahren</span>
                    <span class="text-sm text-gray-900">{{ tan_session.tan_mode }}</span>
                </div>
                {% endif %}
                {% if tan_session.tan_medium %}
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-500">TAN-Medium</span>
                    <span class="text-sm text-gray-900">{{ tan_session.tan_medium }}</span>
                </div>
                {% endif %}
                <!-- Progress bar -->
                <div class="mt-2">
                    <div class="flex items-center justify-between text-xs text-gray-500 mb-1">
                        <span>Session-Gültigkeit</span>
                        <span>{{ tan_session.progress_percent }}% verbraucht</span>
                    </div>
                    <div class="w-full bg-gray-200 rounded-full h-2">
                        <div class="h-2 rounded-full {% if tan_session.progress_percent < 70 %}bg-green-500{% elseif tan_session.progress_percent < 90 %}bg-yellow-500{% else %}bg-red-500{% endif %}"
                             style="width: {{ tan_session.progress_percent }}%"></div>
                    </div>
                </div>
                <p class="text-xs text-gray-400 mt-2">
                    Gemäß PSD2 ist die starke Kundenauthentifizierung (SCA) für den Kontozugriff bis zu 90 Tage gültig.
                    Nach Ablauf wird eine neue TAN-Eingabe erforderlich.
                </p>
            </div>
            {% else %}
            <div class="text-center py-4">
                <span class="text-3xl">🔓</span>
                <p class="mt-2 text-sm text-gray-500">Keine aktive TAN-Session vorhanden</p>
                <p class="text-xs text-gray-400 mt-1">Eine Session wird bei der nächsten Synchronisierung mit TAN-Bestätigung erstellt.</p>
            </div>
            {% endif %}
        </div>
    </div>

    <!-- TAN Input Modal -->
    <div x-show="showTanModal" x-cloak 
         class="fixed inset-0 z-50 overflow-y-auto" 
         aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
            <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" @click="closeModal"></div>
            <span class="hidden sm:inline-block sm:align-middle sm:h-screen">&#8203;</span>
            <div class="inline-block align-bottom bg-white rounded-lg px-4 pt-5 pb-4 text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full sm:p-6">
                <div>
                    <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full" :class="isDecoupled ? 'bg-blue-100' : 'bg-yellow-100'">
                        <span class="text-2xl" x-text="isDecoupled ? '📱' : '🔐'"></span>
                    </div>
                    <div class="mt-3 text-center sm:mt-5">
                        <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title" x-text="isDecoupled ? 'App-Bestätigung erforderlich' : 'TAN-Eingabe erforderlich'"></h3>
                        <div class="mt-2">
                            <p class="text-sm text-gray-500" x-text="tanRequest?.challenge || (isDecoupled ? 'Bitte bestätigen Sie in Ihrer Banking-App' : 'Bitte geben Sie Ihre TAN ein')"></p>
                            <p x-show="tanRequest?.tan_medium" class="text-sm text-gray-500 mt-1">
                                Medium: <span x-text="tanRequest?.tan_medium"></span>
                            </p>
                        </div>
                        
                        <!-- Decoupled: Show waiting animation -->
                        <div x-show="isDecoupled" class="mt-6">
                            <div class="flex justify-center">
                                <div class="loading-spinner" style="width: 40px; height: 40px; border-width: 4px;"></div>
                            </div>
                            <p class="mt-4 text-sm text-gray-600" x-text="pollingStatus"></p>
                            <p class="mt-2 text-xs text-gray-400">Die Seite aktualisiert sich automatisch nach der Bestätigung</p>
                        </div>
                        
                        <!-- Regular TAN: Show input field -->
                        <div x-show="!isDecoupled" class="mt-4">
                            <input type="text" x-model="tanInput" @keyup.enter="submitTan"
                                   class="block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm border px-3 py-2 text-center text-lg tracking-widest"
                                   placeholder="TAN eingeben" autofocus>
                        </div>
                    </div>
                </div>
                <div class="mt-5 sm:mt-6" :class="isDecoupled ? '' : 'sm:grid sm:grid-cols-2 sm:gap-3 sm:grid-flow-row-dense'">
                    <!-- Regular TAN: Confirm button -->
                    <button x-show="!isDecoupled" type="button" @click="submitTan" :disabled="submittingTan"
                            class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-primary-600 text-base font-medium text-white hover:bg-primary-700 focus:outline-none sm:col-start-2 sm:text-sm disabled:opacity-50">
                        <span x-show="submittingTan" class="loading-spinner mr-2"></span>
                        Bestätigen
                    </button>
                    <!-- Cancel button -->
                    <button type="button" @click="closeModal"
                            class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none sm:mt-0 sm:text-sm"
                            :class="isDecoupled ? '' : 'sm:col-start-1'">
                        Abbrechen
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bank Capabilities Card -->
    <div class="bg-white shadow rounded-lg overflow-hidden" x-data="bankCapabilities({{ bank.id }})">
        <div class="px-4 py-5 sm:px-6 border-b border-gray-200 flex justify-between items-center">
            <div>
                <h3 class="text-lg font-medium leading-6 text-gray-900">FinTS-Fähigkeiten</h3>
                <p class="mt-1 text-sm text-gray-500">Unterstützte Funktionen dieser Bank</p>
            </div>
            <button @click="fetchCapabilities" :disabled="loading"
                    class="inline-flex items-center rounded-md bg-gray-100 px-3 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-200 disabled:opacity-50">
                <span x-show="loading" class="loading-spinner mr-2"></span>
                <span x-text="loading ? 'Lade...' : (capabilities ? '↻ Aktualisieren' : 'Abrufen')"></span>
            </button>
        </div>
        
        <div class="px-4 py-5 sm:px-6">
            <!-- Not loaded yet -->
            <div x-show="!capabilities && !loading && !error" class="text-center py-4">
                <p class="text-sm text-gray-500">Klicken Sie auf "Abrufen" um die Bankfähigkeiten zu laden.</p>
            </div>
            
            <!-- Error -->
            <div x-show="error" class="rounded-md bg-red-50 p-4">
                <p class="text-sm text-red-700" x-text="error"></p>
            </div>
            
            <!-- Capabilities loaded -->
            <div x-show="capabilities" x-cloak class="space-y-6">
                <!-- Quick Status Badges -->
                <div class="flex flex-wrap gap-2">
                    <span x-show="capabilities?.supports_psd2" 
                          class="inline-flex items-center rounded-full bg-blue-100 px-3 py-1 text-sm font-medium text-blue-800">
                        PSD2
                    </span>
                    <span x-show="capabilities?.transactions_supported" 
                          class="inline-flex items-center rounded-full bg-green-100 px-3 py-1 text-sm font-medium text-green-800">
                        ✓ Transaktionen
                    </span>
                    <span x-show="!capabilities?.transactions_supported" 
                          class="inline-flex items-center rounded-full bg-red-100 px-3 py-1 text-sm font-medium text-red-800">
                        ✗ Transaktionen
                    </span>
                </div>

                <!-- Read Operations -->
                <div>
                    <h4 class="text-sm font-semibold text-gray-900 mb-3 flex items-center">
                        <span class="mr-2">📖</span> Lesezugriff
                    </h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                        <template x-for="(feature, key) in capabilities?.read" :key="key">
                            <div class="border rounded-lg p-3" :class="feature.supported ? 'border-green-200 bg-green-50' : (feature.available ? 'border-yellow-200 bg-yellow-50' : 'border-gray-200 bg-gray-50')">
                                <div class="flex items-center justify-between">
                                    <span class="text-sm font-medium text-gray-900" x-text="getFeatureName('read', key)"></span>
                                    <span x-show="feature.supported" class="text-green-600 text-sm">✓</span>
                                    <span x-show="!feature.supported && feature.available" class="text-yellow-600 text-sm" title="Bank unterstützt, aber nicht von phpFinTS">⚠</span>
                                    <span x-show="!feature.available" class="text-gray-400 text-sm">—</span>
                                </div>
                                <p class="text-xs text-gray-500 mt-1">
                                    Bank: <span x-text="feature.bank_versions?.length ? feature.bank_versions.join(', ') : '—'"></span>
                                    <span class="text-gray-400 ml-1">(Lib: <span x-text="feature.library_versions?.join(', ')"></span>)</span>
                                </p>
                            </div>
                        </template>
                    </div>
                </div>

                <!-- Transfer Operations -->
                <div>
                    <h4 class="text-sm font-semibold text-gray-900 mb-3 flex items-center">
                        <span class="mr-2">💸</span> Überweisungen
                    </h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                        <template x-for="(feature, key) in capabilities?.transfers" :key="key">
                            <div class="border rounded-lg p-3" :class="feature.supported ? 'border-green-200 bg-green-50' : (feature.available ? 'border-yellow-200 bg-yellow-50' : 'border-gray-200 bg-gray-50')">
                                <div class="flex items-center justify-between">
                                    <span class="text-sm font-medium text-gray-900" x-text="getFeatureName('transfers', key)"></span>
                                    <span x-show="feature.supported" class="text-green-600 text-sm">✓</span>
                                    <span x-show="!feature.supported && feature.available" class="text-yellow-600 text-sm" title="Bank unterstützt, aber nicht von phpFinTS">⚠</span>
                                    <span x-show="!feature.available" class="text-gray-400 text-sm">—</span>
                                </div>
                                <p class="text-xs text-gray-500 mt-1">
                                    Bank: <span x-text="feature.bank_versions?.length ? feature.bank_versions.join(', ') : '—'"></span>
                                </p>
                            </div>
                        </template>
                    </div>
                </div>

                <!-- Direct Debit Operations -->
                <div>
                    <h4 class="text-sm font-semibold text-gray-900 mb-3 flex items-center">
                        <span class="mr-2">📥</span> Lastschriften
                    </h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                        <template x-for="(feature, key) in capabilities?.direct_debits" :key="key">
                            <div class="border rounded-lg p-3" :class="feature.supported ? 'border-green-200 bg-green-50' : (feature.available ? 'border-yellow-200 bg-yellow-50' : 'border-gray-200 bg-gray-50')">
                                <div class="flex items-center justify-between">
                                    <span class="text-sm font-medium text-gray-900" x-text="getFeatureName('direct_debits', key)"></span>
                                    <span x-show="feature.supported" class="text-green-600 text-sm">✓</span>
                                    <span x-show="!feature.supported && feature.available" class="text-yellow-600 text-sm" title="Bank unterstützt, aber nicht von phpFinTS">⚠</span>
                                    <span x-show="!feature.available" class="text-gray-400 text-sm">—</span>
                                </div>
                                <p class="text-xs text-gray-500 mt-1">
                                    Bank: <span x-text="feature.bank_versions?.length ? feature.bank_versions.join(', ') : '—'"></span>
                                </p>
                            </div>
                        </template>
                    </div>
                </div>

                <!-- Legend & Bank Info -->
                <div class="pt-4 border-t border-gray-200">
                    <div class="flex flex-wrap gap-4 text-xs text-gray-500 mb-3">
                        <span><span class="text-green-600">✓</span> = Unterstützt</span>
                        <span><span class="text-yellow-600">⚠</span> = Bank unterstützt, phpFinTS nicht</span>
                        <span><span class="text-gray-400">—</span> = Nicht verfügbar</span>
                    </div>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
                        <div>
                            <span class="text-gray-500">Bank (BPD):</span>
                            <span class="ml-1 text-gray-900" x-text="capabilities?.bank_name_from_bpd || capabilities?.bank_name || '-'"></span>
                        </div>
                        <div>
                            <span class="text-gray-500">BPD-Version:</span>
                            <span class="ml-1 text-gray-900" x-text="capabilities?.bpd_version || '-'"></span>
                        </div>
                        <div>
                            <span class="text-gray-500">TAN-Verfahren:</span>
                            <span class="ml-1 text-gray-900" x-text="capabilities?.tan_modes?.length || 0"></span>
                        </div>
                        <div x-show="cached">
                            <span class="text-gray-500">Cache:</span>
                            <span class="ml-1 text-gray-400" x-text="cacheInfo"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Error/Success Messages -->
    <div x-show="message" x-cloak>
        <div x-show="message?.type === 'success'" class="rounded-md bg-green-50 p-4">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="ml-3">
                    <p class="text-sm font-medium text-green-800" x-text="message?.text"></p>
                </div>
            </div>
        </div>
        <div x-show="message?.type === 'error'" class="rounded-md bg-red-50 p-4">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="ml-3">
                    <p class="text-sm font-medium text-red-800" x-text="message?.text"></p>
                </div>
            </div>
        </div>
    </div>

    <!-- Regular Accounts List -->
    {% set regular_accounts = accounts|filter(a => a.account_type != 'depot') %}
    <div class="bg-white shadow rounded-lg">
        <div class="px-4 py-5 sm:px-6 border-b border-gray-200 flex justify-between items-center">
            <h3 class="text-lg font-medium leading-6 text-gray-900">Konten</h3>
            <div class="flex items-center gap-3">
                <span class="text-xs text-gray-400" title="Manuelle TAN-Freigabe: Bei abgelaufener PIN wird kein automatischer TAN-Abruf durchgeführt – TAN muss manuell über die UI bestätigt werden. Das Konto wird weiterhin synchronisiert.">🔐 TAN</span>
                <span class="text-xs text-gray-400" title="MQTT aktivieren um Kontodaten an Home Assistant zu senden">📡 MQTT</span>
            </div>
        </div>
        
        {% if regular_accounts|length > 0 %}
        <ul role="list" class="divide-y divide-gray-200">
            {% for account in regular_accounts %}
            <li class="hover:bg-gray-50" x-data="accountItem({{ account.id }}, '{{ (account.custom_name ?? account.account_name ?? 'Konto')|e('js') }}', {{ account.linked_depot_id ?? 'null' }})">
                <div class="flex items-center px-4 py-4 sm:px-6">
                    <a href="/accounts/{{ account.id }}" class="flex-shrink-0">
                        <span class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-blue-100">
                            <span class="text-lg">💳</span>
                        </span>
                    </a>
                    <div class="ml-4 flex-1 min-w-0">
                        <div class="flex items-center gap-2">
                            <a x-show="!editing" href="/accounts/{{ account.id }}" class="text-sm font-medium text-gray-900 hover:text-primary-600" x-text="displayName"></a>
                            <input x-show="editing" x-model="editName" @keyup.enter="saveName" @keyup.escape="cancelEdit"
                                   x-ref="nameInput" type="text"
