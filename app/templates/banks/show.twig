function bankCapabilities(bankId) {
    return {
        bankId: bankId,
        loading: false,
        capabilities: null,
        error: null,
        cached: false,
        cacheInfo: '',

        // Feature name translations
        featureNames: {
            read: {
                transactions_mt940: 'Transaktionen (MT940)',
                transactions_camt: 'Transaktionen (CAMT)',
                balance: 'Kontostand',
                sepa_accounts: 'SEPA-Konten',
                depot: 'Depot/Wertpapiere'
            },
            transfers: {
                sepa_single: 'SEPA-Überweisung',
                sepa_batch: 'SEPA-Sammelüberweisung',
                sepa_scheduled: 'Terminüberweisung',
                sepa_scheduled_batch: 'Termin-Sammelüberweisung',
                instant: 'Echtzeit-Überweisung',
                international: 'Auslandsüberweisung'
            },
            direct_debits: {
                sepa_single: 'SEPA-Lastschrift',
                sepa_batch: 'SEPA-Sammellastschrift',
                sepa_b2b_single: 'B2B-Lastschrift',
                sepa_b2b_batch: 'B2B-Sammellastschrift'
            }
        },

        init() {
            // Auto-load capabilities on page load
            this.fetchCapabilities();
        },

        getFeatureName(category, key) {
            return this.featureNames[category]?.[key] || key;
        },

        async fetchCapabilities(forceRefresh = false) {
            this.loading = true;
            this.error = null;

            try {
                const url = `/api/banks/${this.bankId}/capabilities` + (forceRefresh ? '?refresh=1' : '');
                const response = await fetch(url);
                const data = await response.json();

                if (data.success) {
                    this.capabilities = data.capabilities;
                    this.cached = data.cached || false;
                    
                    if (data.cache_age) {
                        const hours = Math.floor(data.cache_age / 3600);
                        const minutes = Math.floor((data.cache_age % 3600) / 60);
                        this.cacheInfo = hours > 0 ? `vor ${hours}h ${minutes}m` : `vor ${minutes}m`;
                    }
                    
                    if (data.refresh_error) {
                        this.error = 'Hinweis: ' + data.refresh_error + ' (zeige gecachte Daten)';
                    }
                } else {
                    this.error = data.message || 'Fehler beim Laden der Bankfähigkeiten';
                }
            } catch (error) {
                this.error = 'Netzwerkfehler: ' + error.message;
            }

            this.loading = false;
        }
    }
}

function activityLog(bankId) {
    return {
        bankId: bankId,
        showLog: false,
        loadingLog: false,
        activities: [],
        
        formatDate(dateStr) {
            if (!dateStr) return '-';
            const date = utcDate(dateStr);
            if (!date) return '-';
            return date.toLocaleString('de-DE', {
                day: '2-digit',
                month: '2-digit',
                hour: '2-digit',
                minute: '2-digit'
            });
        },
        
        formatAction(action) {
            const actionNames = {
                'sync_all': '🔄 Alles synchronisieren',
                'fetch_balance': '💰 Saldo abrufen',
                'fetch_transactions': '📋 Transaktionen',
                'fetch_holdings': '📈 Wertpapiere',
                'fetch_accounts': '📁 Konten abrufen',
                'sync_error': '❌ Fehler'
            };
            return actionNames[action] || action;
        },
        
        async loadActivities() {
            this.loadingLog = true;
            try {
                const response = await fetch(`/api/banks/${this.bankId}/activity-log`);
                const data = await response.json();
                if (data.success) {
                    this.activities = data.activities;
                }
            } catch (error) {
                console.error('Failed to load activity log:', error);
            }
            this.loadingLog = false;
        },
        
        init() {
            // Load activities when log is first opened
            this.$watch('showLog', (value) => {
                if (value && this.activities.length === 0) {
                    this.loadActivities();
                }
            });
        }
    }
}

function bankDetails(bankId) {
    return {
        bankId: bankId,
        loading: false,
        syncingBalances: false,
        syncingAll: false,
        resettingSession: false,
        showTanModal: false,
        tanRequest: null,
        tanInput: '',
        submittingTan: false,
        message: null,
        isDecoupled: false,
        pollingInterval: null,
        pollingStatus: '',
        authorization: {{ bank.authorization|json_encode(15)|raw }},
        manualAuthorization: false,
        requestBusy: false,
        pollAttempts: 0,
        operationId: null,
        operationExpiresAt: null,
        authorizationRequestId: null,
        nextPollAt: 0,
        authorizationContext: null,
        authorizationAccountName: '',
        contextError: null,
        authorizationAccounts: [{% for account in accounts %}{id: {{ account.id }}, name: '{{ (account.custom_name ?? account.account_name ?? account.iban ?? 'Konto')|e('js') }}'}{{ not loop.last ? ',' : '' }}{% endfor %}],

        init() {
            const params = new URLSearchParams(location.search);
            if (!['account_id', 'from', 'to'].some(key => params.has(key))) return;
            const accountId = params.get('account_id') || '';
            const from = params.get('from') || '';
            const to = params.get('to') || '';
            const account = this.authorizationAccounts.find(item => String(item.id) === accountId);
            const validDate = value => {
                if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
                const date = new Date(value + 'T00:00:00Z');
                return !Number.isNaN(date.getTime()) && date.toISOString().slice(0, 10) === value;
            };
            if (!account || !validDate(from) || !validDate(to) || from > to) {
                this.contextError = 'Ungültige Konto-/Zeitraumauswahl. Bitte Auswahl entfernen oder erneut auf der Kontoseite wählen.';
                return;
            }
            this.authorizationContext = { account_id: Number(accountId), from, to };
            this.authorizationAccountName = account.name;
        },

        get busy() {
            return this.loading || this.syncingBalances || this.syncingAll || this.resettingSession || this.requestBusy || this.manualAuthorization || this.authorization.status === 'pending';
        },

        get authorizationLabel() {
            return { unknown: 'Freigabestatus unbekannt', authorized: 'Bankzugang freigegeben', required: 'Bankfreigabe erforderlich', pending: 'Bankfreigabe ausstehend', error: 'Fehler beim Bankzugang' }[this.authorization.status] || 'Freigabestatus unbekannt';
        },

        formatDate(value) {
            return utcDate(value)?.toLocaleString('de-DE') || 'Unbekannt';
        },

        async refreshAuthorization() {
            const response = await fetch(`/api/banks/${this.bankId}/tan-session`);
            const data = await response.json();
            if (!response.ok) throw new Error(data.message || 'Status konnte nicht geladen werden');
            this.authorization = data.authorization || data.authorization_state || this.authorization;
            this.operationId = data.operation_id || null;
            this.operationExpiresAt = data.operation_expires_at || null;
            return data;
        },

        async authorize() {
            if (this.busy || this.contextError) return;
            this.manualAuthorization = true;
            this.pollAttempts = 0;
            this.requestBusy = true;
            this.message = null;
            try {
                this.authorizationRequestId ??= Array.from(crypto.getRandomValues(new Uint8Array(24)), byte => byte.toString(16).padStart(2, '0')).join('');
                const response = await fetch(`/api/banks/${this.bankId}/authorize`, {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ request_id: this.authorizationRequestId, ...(this.authorizationContext || {}) })
                });
                const data = await response.json();
                this.handleAuthorizationResponse(data);
            } catch (error) {
                this.manualAuthorization = false;
                this.message = { type: 'error', text: 'Freigabestatus unklar: ' + error.message + '. Bitte Status auf der Bankseite prüfen, nicht erneut anfordern.' };
            } finally {
                this.requestBusy = false;
                await this.refreshAuthorization().catch(() => {});
            }
        },

        async resumeAuthorization() {
            if (this.requestBusy) return;
            this.requestBusy = true;
            try {
                const data = await this.refreshAuthorization();
                if (data.tan_request) {
                    this.manualAuthorization = true;
                    this.pollAttempts = 0;
                    this.handleAuthorizationResponse({ ...data, needs_tan: true });
                } else {
                    this.message = { type: 'error', text: 'Keine fortsetzbare TAN-Anfrage vorhanden. Freigabe gegebenenfalls abbrechen und neu starten.' };
                }
            } catch (error) {
                this.message = { type: 'error', text: error.message };
            } finally {
                this.requestBusy = false;
            }
        },

        handleAuthorizationResponse(data) {
            if (data.authorization) this.authorization = data.authorization;
            if (data.operation_id) {
                if (this.operationId !== data.operation_id) this.pollAttempts = 0;
                this.operationId = data.operation_id;
            }
            if (data.operation_expires_at) this.operationExpiresAt = data.operation_expires_at;
            if (data.needs_tan && this.manualAuthorization) {
                this.tanRequest = data.tan_request;
                this.isDecoupled = !!data.tan_request?.is_decoupled;
                this.showTanModal = true;
                this.authorization.status = 'pending';
                this.tanInput = '';
                this.stopDecoupledPolling();
                this.nextPollAt = Date.now() + Math.max(3, Number(this.tanRequest?.poll_interval) || 3) * 1000;
                if (this.isDecoupled) this.startDecoupledPolling();
            } else {
                this.stopDecoupledPolling();
                this.showTanModal = false;
                this.manualAuthorization = false;
                this.authorizationRequestId = null;
                const warning = safeSyncWarning(data);
                this.message = { type: data.success && !warning ? 'success' : 'error', text: warning || data.message || (data.success ? 'Freigabe und Kontenabruf abgeschlossen.' : 'Freigabe fehlgeschlagen.') };
                if (data.success && !warning) setTimeout(() => location.reload(), 1500);
            }
        },

        async resetSession() {
            if (this.busy) return;
            if (!confirm('Technische Session zurücksetzen? Eine notwendige Bankfreigabe muss anschließend ausdrücklich über „Bankzugang freigeben“ gestartet werden.')) {
                return;
            }
            
            this.resettingSession = true;
            this.message = null;
            
            try {
                const response = await fetch(`/api/banks/${this.bankId}/reset-session`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();
                
                if (data.success) {
                    this.message = { type: 'success', text: data.message };
                } else {
                    this.message = { type: 'error', text: data.message || 'Fehler beim Zurücksetzen' };
                }
            } catch (error) {
                this.message = { type: 'error', text: 'Netzwerkfehler: ' + error.message };
            }
            
            this.resettingSession = false;
            await this.refreshAuthorization().catch(() => {});
        },

        async syncAll() {
            if (this.busy) return;
            this.syncingAll = true;
            this.message = null;

            try {
                const response = await fetch(`/api/banks/${this.bankId}/sync-all`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();

                const warning = safeSyncWarning(data);
                if (warning) {
                    this.message = { type: 'error', text: warning };
                } else if (data.success) {
                    const stats = data.stats || {};
                    let msg = '✓ Synchronisierung abgeschlossen: ';
                    const parts = [];
                    if (stats.balances_updated > 0) parts.push(`${stats.balances_updated} Salden`);
                    if (stats.transactions_new > 0) parts.push(`${stats.transactions_new} neue Transaktionen`);
                    if (stats.transactions_updated > 0) parts.push(`${stats.transactions_updated} aktualisierte Transaktionen`);
                    if (stats.holdings_updated > 0) parts.push(`${stats.holdings_updated} Wertpapiere`);
                    msg += parts.length > 0 ? parts.join(', ') : 'Alles aktuell';
                    
                    if (stats.errors && stats.errors.length > 0) {
                        msg += ` (${stats.errors.length} Fehler)`;
                    }
                    
                    this.message = { type: 'success', text: msg };
                    setTimeout(() => location.reload(), 2000);
                } else {
                    this.message = { type: 'error', text: data.message || 'Fehler bei der Synchronisierung' };
                }
            } catch (error) {
                this.message = { type: 'error', text: 'Netzwerkfehler: ' + error.message };
            }

            this.syncingAll = false;
            await this.refreshAuthorization().catch(() => {});
        },

        async fetchAccounts() {
            if (this.busy) return;
            this.loading = true;
            this.message = null;

            try {
                const response = await fetch(`/api/banks/${this.bankId}/accounts`);
                const data = await response.json();

                const warning = safeSyncWarning(data);
                if (warning) {
                    this.message = { type: 'error', text: warning };
                } else if (data.success) {
                    this.message = { type: 'success', text: 'Konten erfolgreich abgerufen!' };
                    setTimeout(() => location.reload(), 1000);
                } else {
                    this.message = { type: 'error', text: data.message || 'Fehler beim Abrufen der Konten' };
                }
            } catch (error) {
                this.message = { type: 'error', text: 'Netzwerkfehler: ' + error.message };
            }

            this.loading = false;
            await this.refreshAuthorization().catch(() => {});
        },
        
        async syncBalances() {
            if (this.busy) return;
            this.syncingBalances = true;
            this.message = null;

            try {
                const response = await fetch(`/api/banks/${this.bankId}/balances`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();

                const warning = safeSyncWarning(data);
                if (warning) {
                    this.message = { type: 'error', text: warning };
                } else if (data.success) {
                    this.message = { type: 'success', text: `${data.updated_count} Kontosalden aktualisiert!` };
                    setTimeout(() => location.reload(), 1500);
                } else {
                    this.message = { type: 'error', text: data.message || 'Fehler beim Abrufen der Salden' };
                }
            } catch (error) {
                this.message = { type: 'error', text: 'Netzwerkfehler: ' + error.message };
            }

            this.syncingBalances = false;
            await this.refreshAuthorization().catch(() => {});
        },

        startDecoupledPolling() {
            if (!this.manualAuthorization) return;
            this.stopDecoupledPolling();
            if (this.tanRequest?.automated_polling_allowed !== true) {
                this.pollingStatus = 'Automatische Prüfung ist für dieses Verfahren nicht erlaubt. Nach Bestätigung in der App bitte „Bestätigung jetzt prüfen“ wählen.';
                return;
            }
            this.pollingStatus = 'Warte auf Bestätigung in der Banking-App...';
            const delay = Math.max(3, Number(this.tanRequest?.poll_interval) || 3) * 1000;
            this.pollingInterval = setInterval(() => this.checkDecoupledStatus(), delay);
        },

        stopDecoupledPolling() {
            if (this.pollingInterval) {
                clearInterval(this.pollingInterval);
                this.pollingInterval = null;
            }
        },

        async checkDecoupledStatus(manual = false) {
            if (!this.manualAuthorization || this.requestBusy) return;
            if (!manual && this.tanRequest?.automated_polling_allowed !== true) return;
            const expires = utcDate(this.operationExpiresAt);
            if (expires && expires.getTime() <= Date.now()) {
                this.stopDecoupledPolling();
                this.pollingStatus = 'Freigabe abgelaufen. Bitte abbrechen und bei Bedarf ausdrücklich neu starten.';
                return;
            }
            if (Date.now() < this.nextPollAt) {
                this.pollingStatus = 'Bitte die von der Bank vorgegebene Wartezeit abwarten und anschließend erneut prüfen.';
                return;
            }
            const bankLimit = Number(this.tanRequest?.max_polls) || 100;
            if (++this.pollAttempts > Math.min(100, bankLimit)) {
                this.stopDecoupledPolling();
                this.pollingStatus = 'Zeitlimit erreicht. Bitte Freigabe abbrechen oder auf der Bankseite fortsetzen.';
                return;
            }
            this.requestBusy = true;
            try {
                const response = await fetch(`/api/banks/${this.bankId}/decoupled`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ operation_id: this.operationId })
                });
                const data = await response.json();

                this.handleAuthorizationResponse(data);
            } catch (error) {
                this.stopDecoupledPolling();
                this.pollingStatus = 'Netzwerkfehler. Bitte Freigabe abbrechen oder auf der Bankseite fortsetzen.';
            } finally {
                this.requestBusy = false;
                if (!this.showTanModal) {
                    this.manualAuthorization = false;
                    await this.refreshAuthorization().catch(() => {});
                }
            }
        },

        async submitTan() {
            if (!this.manualAuthorization || this.requestBusy || !this.tanInput.trim()) return;
            
            this.requestBusy = true;
            this.submittingTan = true;

            try {
                const response = await fetch(`/api/banks/${this.bankId}/tan`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ tan: this.tanInput, operation_id: this.operationId })
                });
                const data = await response.json();

                this.handleAuthorizationResponse(data);
            } catch (error) {
                this.message = { type: 'error', text: 'Netzwerkfehler: ' + error.message };
                this.showTanModal = false;
            }

            this.submittingTan = false;
            this.requestBusy = false;
            this.tanInput = '';
            if (!this.showTanModal) {
                this.manualAuthorization = false;
                await this.refreshAuthorization().catch(() => {});
            }
        },

        async closeModal() {
            if (this.requestBusy) return;
            this.stopDecoupledPolling();
            this.tanInput = '';
            this.requestBusy = true;
            try {
                if (!this.operationId) await this.refreshAuthorization();
                if (!this.operationId) throw new Error('Diese Freigabe kann nur im Browser fortgesetzt oder abgebrochen werden, der sie gestartet hat.');
                const response = await fetch(`/api/banks/${this.bankId}/authorization/cancel`, {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ operation_id: this.operationId })
                });
                const data = await response.json();
                if (!response.ok || !data.success) throw new Error(data.message || 'Abbruch fehlgeschlagen');
                this.showTanModal = false;
                this.manualAuthorization = false;
                this.isDecoupled = false;
                this.authorizationRequestId = null;
                this.message = { type: 'success', text: 'Freigabe abgebrochen. Gespeicherte Kontodaten bleiben erhalten.' };
                await this.refreshAuthorization();
            } catch (error) {
                this.message = { type: 'error', text: error.message };
                this.pollingStatus = 'Abbruch nicht bestätigt. Bitte erneut abbrechen oder den Status prüfen.';
            } finally {
                this.requestBusy = false;
            }
        },

        destroy() {
            this.stopDecoupledPolling();
        }
    }
}
</script>
