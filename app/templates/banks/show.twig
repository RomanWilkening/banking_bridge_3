{% extends "layout.twig" %}

{% block content %}
<div x-data="bankDetails({{ bank.id }})" class="space-y-6">
    <!-- Bank Info Card -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
        <div class="px-4 py-5 sm:px-6 flex justify-between items-center border-b border-gray-200">
            <div class="flex items-center">
                <span class="inline-flex items-center justify-center h-14 w-14 rounded-full bg-primary-100">
                    <span class="text-2xl">🏦</span>
                </span>
                <div class="ml-4">
                    <h3 class="text-lg font-medium text-gray-900">{{ bank.name }}</h3>
                    <p class="text-sm text-gray-500">BLZ: {{ bank.bank_code }}</p>
                </div>
            </div>
            <div class="flex space-x-3">
                <button @click="fetchAccounts" :disabled="loading"
                        class="inline-flex items-center rounded-md bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-primary-500 disabled:opacity-50">
                    <span x-show="loading" class="loading-spinner mr-2"></span>
                    <span x-text="loading ? 'Lade...' : 'Konten abrufen'"></span>
                </button>
                <form method="POST" action="/banks/{{ bank.id }}/delete" 
                      onsubmit="return confirm('Sind Sie sicher, dass Sie diese Bankverbindung löschen möchten?');">
                    <button type="submit" class="inline-flex items-center rounded-md bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500">
                        Löschen
                    </button>
                </form>
            </div>
        </div>
        
        <div class="px-4 py-5 sm:px-6">
            <dl class="grid grid-cols-1 gap-x-4 gap-y-4 sm:grid-cols-2">
                <div>
                    <dt class="text-sm font-medium text-gray-500">FinTS-URL</dt>
                    <dd class="mt-1 text-sm text-gray-900 break-all">{{ bank.fints_url }}</dd>
                </div>
                <div>
                    <dt class="text-sm font-medium text-gray-500">Benutzer</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ bank.username }}</dd>
                </div>
                <div>
                    <dt class="text-sm font-medium text-gray-500">Erstellt am</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ bank.created_at|date('d.m.Y H:i') }}</dd>
                </div>
                <div>
                    <dt class="text-sm font-medium text-gray-500">Aktualisiert am</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ bank.updated_at|date('d.m.Y H:i') }}</dd>
                </div>
            </dl>
        </div>
    </div>

    <!-- TAN Input Modal -->
    <div x-show="showTanModal" x-cloak 
         class="fixed inset-0 z-50 overflow-y-auto" 
         aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
            <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" @click="closeModal"></div>
            <span class="hidden sm:inline-block sm:align-middle sm:h-screen">&#8203;</span>
            <div class="inline-block align-bottom bg-white rounded-lg px-4 pt-5 pb-4 text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full sm:p-6">
                <div>
                    <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full" :class="isDecoupled ? 'bg-blue-100' : 'bg-yellow-100'">
                        <span class="text-2xl" x-text="isDecoupled ? '📱' : '🔐'"></span>
                    </div>
                    <div class="mt-3 text-center sm:mt-5">
                        <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title" x-text="isDecoupled ? 'App-Bestätigung erforderlich' : 'TAN-Eingabe erforderlich'"></h3>
                        <div class="mt-2">
                            <p class="text-sm text-gray-500" x-text="tanRequest?.challenge || (isDecoupled ? 'Bitte bestätigen Sie in Ihrer Banking-App' : 'Bitte geben Sie Ihre TAN ein')"></p>
                            <p x-show="tanRequest?.tan_medium" class="text-sm text-gray-500 mt-1">
                                Medium: <span x-text="tanRequest?.tan_medium"></span>
                            </p>
                        </div>
                        
                        <!-- Decoupled: Show waiting animation -->
                        <div x-show="isDecoupled" class="mt-6">
                            <div class="flex justify-center">
                                <div class="loading-spinner" style="width: 40px; height: 40px; border-width: 4px;"></div>
                            </div>
                            <p class="mt-4 text-sm text-gray-600" x-text="pollingStatus"></p>
                            <p class="mt-2 text-xs text-gray-400">Die Seite aktualisiert sich automatisch nach der Bestätigung</p>
                        </div>
                        
                        <!-- Regular TAN: Show input field -->
                        <div x-show="!isDecoupled" class="mt-4">
                            <input type="text" x-model="tanInput" @keyup.enter="submitTan"
                                   class="block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm border px-3 py-2 text-center text-lg tracking-widest"
                                   placeholder="TAN eingeben" autofocus>
                        </div>
                    </div>
                </div>
                <div class="mt-5 sm:mt-6" :class="isDecoupled ? '' : 'sm:grid sm:grid-cols-2 sm:gap-3 sm:grid-flow-row-dense'">
                    <!-- Regular TAN: Confirm button -->
                    <button x-show="!isDecoupled" type="button" @click="submitTan" :disabled="submittingTan"
                            class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-primary-600 text-base font-medium text-white hover:bg-primary-700 focus:outline-none sm:col-start-2 sm:text-sm disabled:opacity-50">
                        <span x-show="submittingTan" class="loading-spinner mr-2"></span>
                        Bestätigen
                    </button>
                    <!-- Cancel button -->
                    <button type="button" @click="closeModal"
                            class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none sm:mt-0 sm:text-sm"
                            :class="isDecoupled ? '' : 'sm:col-start-1'">
                        Abbrechen
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bank Capabilities Card -->
    <div class="bg-white shadow rounded-lg overflow-hidden" x-data="bankCapabilities({{ bank.id }})">
        <div class="px-4 py-5 sm:px-6 border-b border-gray-200 flex justify-between items-center">
            <div>
                <h3 class="text-lg font-medium leading-6 text-gray-900">FinTS-Fähigkeiten</h3>
                <p class="mt-1 text-sm text-gray-500">Unterstützte Funktionen dieser Bank</p>
            </div>
            <button @click="fetchCapabilities" :disabled="loading"
                    class="inline-flex items-center rounded-md bg-gray-100 px-3 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-200 disabled:opacity-50">
                <span x-show="loading" class="loading-spinner mr-2"></span>
                <span x-text="loading ? 'Lade...' : (capabilities ? '↻ Aktualisieren' : 'Abrufen')"></span>
            </button>
        </div>
        
        <div class="px-4 py-5 sm:px-6">
            <!-- Not loaded yet -->
            <div x-show="!capabilities && !loading && !error" class="text-center py-4">
                <p class="text-sm text-gray-500">Klicken Sie auf "Abrufen" um die Bankfähigkeiten zu laden.</p>
            </div>
            
            <!-- Error -->
            <div x-show="error" class="rounded-md bg-red-50 p-4">
                <p class="text-sm text-red-700" x-text="error"></p>
            </div>
            
            <!-- Capabilities loaded -->
            <div x-show="capabilities" x-cloak>
                <!-- Transaction Support Status -->
                <div class="mb-6">
                    <h4 class="text-sm font-medium text-gray-900 mb-3">Transaktionsabruf</h4>
                    <div class="flex flex-wrap gap-3">
                        <span x-show="capabilities?.transactions_supported" 
                              class="inline-flex items-center rounded-full bg-green-100 px-3 py-1 text-sm font-medium text-green-800">
                            ✓ Transaktionen möglich
                        </span>
                        <span x-show="!capabilities?.transactions_supported" 
                              class="inline-flex items-center rounded-full bg-red-100 px-3 py-1 text-sm font-medium text-red-800">
                            ✗ Transaktionen nicht unterstützt
                        </span>
                        <span x-show="capabilities?.supports_balance" 
                              class="inline-flex items-center rounded-full bg-green-100 px-3 py-1 text-sm font-medium text-green-800">
                            ✓ Saldenabfrage
                        </span>
                        <span x-show="capabilities?.supports_psd2" 
                              class="inline-flex items-center rounded-full bg-blue-100 px-3 py-1 text-sm font-medium text-blue-800">
                            PSD2
                        </span>
                    </div>
                </div>

                <!-- Format Support -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- MT940 Support -->
                    <div class="border rounded-lg p-4" :class="capabilities?.mt940_supported ? 'border-green-200 bg-green-50' : 'border-gray-200'">
                        <div class="flex items-center justify-between mb-2">
                            <h5 class="text-sm font-medium text-gray-900">MT940 Format</h5>
                            <span x-show="capabilities?.mt940_supported" class="text-green-600">✓ Unterstützt</span>
                            <span x-show="!capabilities?.mt940_supported" class="text-red-600">✗ Nicht unterstützt</span>
                        </div>
                        <p class="text-xs text-gray-500 mb-2">Bank-Versionen: <span x-text="capabilities?.mt940_versions?.length ? capabilities.mt940_versions.join(', ') : 'keine'"></span></p>
                        <p class="text-xs text-gray-400">phpFinTS unterstützt: 4, 5, 6, 7</p>
                    </div>

                    <!-- CAMT XML Support -->
                    <div class="border rounded-lg p-4" :class="capabilities?.camt_supported ? 'border-green-200 bg-green-50' : 'border-gray-200'">
                        <div class="flex items-center justify-between mb-2">
                            <h5 class="text-sm font-medium text-gray-900">CAMT XML Format</h5>
                            <span x-show="capabilities?.camt_supported" class="text-green-600">✓ Unterstützt</span>
                            <span x-show="!capabilities?.camt_supported" class="text-red-600">✗ Nicht unterstützt</span>
                        </div>
                        <p class="text-xs text-gray-500 mb-2">Bank-Versionen: <span x-text="capabilities?.camt_versions?.length ? capabilities.camt_versions.join(', ') : 'keine'"></span></p>
                        <p class="text-xs text-gray-400">phpFinTS unterstützt: 1</p>
                    </div>
                </div>

                <!-- Bank Info from BPD -->
                <div class="mt-4 pt-4 border-t border-gray-200">
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
                        <div>
                            <span class="text-gray-500">Bank (BPD):</span>
                            <span class="ml-1 text-gray-900" x-text="capabilities?.bank_name_from_bpd || '-'"></span>
                        </div>
                        <div>
                            <span class="text-gray-500">BPD-Version:</span>
                            <span class="ml-1 text-gray-900" x-text="capabilities?.bpd_version || '-'"></span>
                        </div>
                        <div>
                            <span class="text-gray-500">TAN-Verfahren:</span>
                            <span class="ml-1 text-gray-900" x-text="capabilities?.tan_modes?.length || 0"></span>
                        </div>
                        <div x-show="cached">
                            <span class="text-gray-500">Cache:</span>
                            <span class="ml-1 text-gray-400" x-text="cacheInfo"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Error/Success Messages -->
    <div x-show="message" x-cloak>
        <div x-show="message?.type === 'success'" class="rounded-md bg-green-50 p-4">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="ml-3">
                    <p class="text-sm font-medium text-green-800" x-text="message?.text"></p>
                </div>
            </div>
        </div>
        <div x-show="message?.type === 'error'" class="rounded-md bg-red-50 p-4">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="ml-3">
                    <p class="text-sm font-medium text-red-800" x-text="message?.text"></p>
                </div>
            </div>
        </div>
    </div>

    <!-- Accounts List -->
    <div class="bg-white shadow rounded-lg">
        <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
            <h3 class="text-lg font-medium leading-6 text-gray-900">Konten</h3>
        </div>
        
        {% if accounts|length > 0 %}
        <ul role="list" class="divide-y divide-gray-200">
            {% for account in accounts %}
            <li>
                <a href="/accounts/{{ account.id }}" class="block hover:bg-gray-50 px-4 py-4 sm:px-6">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center">
                            <div class="flex-shrink-0">
                                <span class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-gray-100">
                                    <span class="text-lg">💳</span>
                                </span>
                            </div>
                            <div class="ml-4">
                                <p class="text-sm font-medium text-gray-900">{{ account.account_name ?? 'Konto' }}</p>
                                <p class="text-sm text-gray-500">{{ account.iban }}</p>
                                {% if account.owner_name %}
                                <p class="text-xs text-gray-400">{{ account.owner_name }}</p>
                                {% endif %}
                            </div>
                        </div>
                        <div class="flex items-center">
                            <div class="text-right mr-4">
                                {% if account.balance is not null %}
                                <p class="text-lg font-semibold {% if account.balance >= 0 %}text-green-600{% else %}text-red-600{% endif %}">
                                    {{ account.balance|number_format(2, ',', '.') }} {{ account.currency }}
                                </p>
                                {% if account.balance_date %}
                                <p class="text-xs text-gray-400">Stand: {{ account.balance_date|date('d.m.Y') }}</p>
                                {% endif %}
                                {% else %}
                                <p class="text-sm text-gray-400">Kein Saldo</p>
                                {% endif %}
                            </div>
                            <svg class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                            </svg>
                        </div>
                    </div>
                </a>
            </li>
            {% endfor %}
        </ul>
        {% else %}
        <div class="px-4 py-12 text-center">
            <span class="text-4xl">💳</span>
            <p class="mt-2 text-sm text-gray-500">Noch keine Konten abgerufen</p>
            <p class="text-sm text-gray-400">Klicken Sie auf "Konten abrufen" um die Konten von der Bank zu laden</p>
        </div>
        {% endif %}
    </div>

    <!-- Back Link -->
    <div>
        <a href="/banks" class="text-sm text-primary-600 hover:text-primary-500">← Zurück zur Übersicht</a>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
function bankCapabilities(bankId) {
    return {
        bankId: bankId,
        loading: false,
        capabilities: null,
        error: null,
        cached: false,
        cacheInfo: '',

        init() {
            // Auto-load capabilities on page load
            this.fetchCapabilities();
        },

        async fetchCapabilities(forceRefresh = false) {
            this.loading = true;
            this.error = null;

            try {
                const url = `/api/banks/${this.bankId}/capabilities` + (forceRefresh ? '?refresh=1' : '');
                const response = await fetch(url);
                const data = await response.json();

                if (data.success) {
                    this.capabilities = data.capabilities;
                    this.cached = data.cached || false;
                    
                    if (data.cache_age) {
                        const hours = Math.floor(data.cache_age / 3600);
                        const minutes = Math.floor((data.cache_age % 3600) / 60);
                        this.cacheInfo = hours > 0 ? `vor ${hours}h ${minutes}m` : `vor ${minutes}m`;
                    }
                    
                    if (data.refresh_error) {
                        this.error = 'Hinweis: ' + data.refresh_error + ' (zeige gecachte Daten)';
                    }
                } else {
                    this.error = data.message || 'Fehler beim Laden der Bankfähigkeiten';
                }
            } catch (error) {
                this.error = 'Netzwerkfehler: ' + error.message;
            }

            this.loading = false;
        }
    }
}

function bankDetails(bankId) {
    return {
        bankId: bankId,
        loading: false,
        showTanModal: false,
        tanRequest: null,
        tanInput: '',
        submittingTan: false,
        message: null,
        isDecoupled: false,
        pollingInterval: null,
        pollingStatus: '',

        async fetchAccounts() {
            this.loading = true;
            this.message = null;

            try {
                const response = await fetch(`/api/banks/${this.bankId}/accounts`);
                const data = await response.json();

                if (data.needs_tan) {
                    this.tanRequest = data.tan_request;
                    this.isDecoupled = data.tan_request?.is_decoupled || false;
                    this.showTanModal = true;
                    
                    // Start polling for decoupled TAN
                    if (this.isDecoupled) {
                        this.pollingStatus = 'Bitte bestätigen Sie die Anfrage in Ihrer Banking-App...';
                        this.startDecoupledPolling();
                    }
                } else if (data.success) {
                    this.message = { type: 'success', text: 'Konten erfolgreich abgerufen!' };
                    setTimeout(() => location.reload(), 1000);
                } else {
                    this.message = { type: 'error', text: data.message || 'Fehler beim Abrufen der Konten' };
                }
            } catch (error) {
                this.message = { type: 'error', text: 'Netzwerkfehler: ' + error.message };
            }

            this.loading = false;
        },

        startDecoupledPolling() {
            // Poll every 3 seconds
            this.pollingInterval = setInterval(() => this.checkDecoupledStatus(), 3000);
        },

        stopDecoupledPolling() {
            if (this.pollingInterval) {
                clearInterval(this.pollingInterval);
                this.pollingInterval = null;
            }
        },

        async checkDecoupledStatus() {
            try {
                const response = await fetch(`/api/banks/${this.bankId}/decoupled`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });
                const data = await response.json();

                if (data.status === 'pending') {
                    // Still waiting, continue polling
                    this.pollingStatus = 'Warte auf Bestätigung in der Banking-App...';
                } else if (data.needs_tan) {
                    // Another TAN needed (might be different type)
                    this.stopDecoupledPolling();
                    this.tanRequest = data.tan_request;
                    this.isDecoupled = data.tan_request?.is_decoupled || false;
                    if (this.isDecoupled) {
                        this.startDecoupledPolling();
                    }
                } else if (data.success) {
                    this.stopDecoupledPolling();
                    this.showTanModal = false;
                    this.message = { type: 'success', text: 'Konten erfolgreich abgerufen!' };
                    setTimeout(() => location.reload(), 1000);
                } else {
                    this.stopDecoupledPolling();
                    this.showTanModal = false;
                    this.message = { type: 'error', text: data.message || 'Fehler bei der Bestätigung' };
                }
            } catch (error) {
                // Don't stop polling on network errors, just log
                console.error('Polling error:', error);
            }
        },

        async submitTan() {
            if (!this.tanInput.trim()) return;
            
            this.submittingTan = true;

            try {
                const response = await fetch(`/api/banks/${this.bankId}/tan`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ tan: this.tanInput })
                });
                const data = await response.json();

                if (data.needs_tan) {
                    this.tanRequest = data.tan_request;
                    this.isDecoupled = data.tan_request?.is_decoupled || false;
                    this.tanInput = '';
                    if (this.isDecoupled) {
                        this.startDecoupledPolling();
                    }
                } else if (data.success) {
                    this.showTanModal = false;
                    this.message = { type: 'success', text: 'Konten erfolgreich abgerufen!' };
                    setTimeout(() => location.reload(), 1000);
                } else {
                    this.message = { type: 'error', text: data.message || 'TAN-Fehler' };
                    this.showTanModal = false;
                }
            } catch (error) {
                this.message = { type: 'error', text: 'Netzwerkfehler: ' + error.message };
                this.showTanModal = false;
            }

            this.submittingTan = false;
            this.tanInput = '';
        },

        closeModal() {
            this.stopDecoupledPolling();
            this.showTanModal = false;
            this.tanInput = '';
            this.isDecoupled = false;
        }
    }
}
</script>
{% endblock %}
