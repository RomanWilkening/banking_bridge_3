{% block scripts %}
<script>
function editableName(type, id, initialName) {
    return {
        type: type,
        id: id,
        displayName: initialName,
        editName: initialName,
        editing: false,
        
        edit() {
            this.editName = this.displayName;
            this.editing = true;
            this.$nextTick(() => this.$refs.nameInput.focus());
        },
        
        async save() {
            if (!this.editName.trim()) {
                this.cancel();
                return;
            }
            
            const url = this.type === 'bank' 
                ? `/api/banks/${this.id}` 
                : `/api/accounts/${this.id}`;
            
            try {
                const response = await fetch(url, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name: this.editName.trim() })
                });
                const data = await response.json();
                
                if (data.success) {
                    this.displayName = this.editName.trim();
                    this.editing = false;
                } else {
                    alert(data.message || 'Fehler beim Speichern');
                }
            } catch (error) {
                alert('Netzwerkfehler: ' + error.message);
            }
        },
        
        cancel() {
            this.editName = this.displayName;
            this.editing = false;
        }
    };
}

function accountItem(accountId, initialName, initialLinkedDepotId) {
    return {
        accountId: accountId,
        displayName: initialName,
        editName: initialName,
        editing: false,
        linkedDepotId: initialLinkedDepotId ? String(initialLinkedDepotId) : '',
        linkingDepot: false,
        
        startEdit() {
            this.editName = this.displayName;
            this.editing = true;
            this.$nextTick(() => this.$refs.nameInput.focus());
        },
        
        async saveName() {
            if (!this.editName.trim()) {
                this.cancelEdit();
                return;
            }
            
            try {
                const response = await fetch(`/api/accounts/${this.accountId}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name: this.editName.trim() })
                });
                const data = await response.json();
                
                if (data.success) {
                    this.displayName = this.editName.trim();
                    this.editing = false;
                } else {
                    alert(data.message || 'Fehler beim Speichern');
                }
            } catch (error) {
                alert('Netzwerkfehler: ' + error.message);
            }
        },
        
        cancelEdit() {
            this.editName = this.displayName;
            this.editing = false;
        },
        
        async linkDepot() {
            this.linkingDepot = true;
            
            try {
                const depotId = this.linkedDepotId ? parseInt(this.linkedDepotId) : null;
                const response = await fetch(`/api/accounts/${this.accountId}/link-depot`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ depot_id: depotId })
                });
                const data = await response.json();
                
                if (!data.success) {
                    alert(data.message || 'Fehler beim Verknüpfen');
                }
            } catch (error) {
                alert('Netzwerkfehler: ' + error.message);
            }
            
            this.linkingDepot = false;
        }
    };
}

function mqttToggle(accountId, initialValue) {
    return {
        accountId: accountId,
        enabled: initialValue == 1,
        
        async toggle() {
            const newValue = !this.enabled;
            
            try {
                const response = await fetch(`/api/accounts/${this.accountId}/mqtt-export`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ enabled: newValue })
                });
                const data = await response.json();
                
                if (data.success) {
                    this.enabled = newValue;
                } else {
                    alert(data.message || 'Fehler beim Aktualisieren');
                }
            } catch (error) {
                alert('Netzwerkfehler: ' + error.message);
            }
        }
    };
}

function tanApprovalToggle(accountId, initialValue) {
    return {
        accountId: accountId,
        enabled: initialValue == 1,
        
        async toggle() {
            const newValue = !this.enabled;
            
            try {
                const response = await fetch(`/api/accounts/${this.accountId}/tan-manual-approval`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ enabled: newValue })
                });
                const data = await response.json();
                
                if (data.success) {
                    this.enabled = newValue;
                } else {
                    alert(data.message || 'Fehler beim Aktualisieren');
                }
            } catch (error) {
                alert('Netzwerkfehler: ' + error.message);
            }
        }
    };
}

function bankCapabilities(bankId) {
    return {
        bankId: bankId,
        loading: false,
        capabilities: null,
        error: null,
        cached: false,
        cacheInfo: '',

        // Feature name translations
        featureNames: {
            read: {
                transactions_mt940: 'Transaktionen (MT940)',
                transactions_camt: 'Transaktionen (CAMT)',
                balance: 'Kontostand',
                sepa_accounts: 'SEPA-Konten',
                depot: 'Depot/Wertpapiere'
            },
            transfers: {
                sepa_single: 'SEPA-Überweisung',
                sepa_batch: 'SEPA-Sammelüberweisung',
                sepa_scheduled: 'Terminüberweisung',
                sepa_scheduled_batch: 'Termin-Sammelüberweisung',
                instant: 'Echtzeit-Überweisung',
                international: 'Auslandsüberweisung'
            },
            direct_debits: {
                sepa_single: 'SEPA-Lastschrift',
                sepa_batch: 'SEPA-Sammellastschrift',
                sepa_b2b_single: 'B2B-Lastschrift',
                sepa_b2b_batch: 'B2B-Sammellastschrift'
            }
        },

        init() {
            // Auto-load capabilities on page load
            this.fetchCapabilities();
        },

        getFeatureName(category, key) {
            return this.featureNames[category]?.[key] || key;
        },

        async fetchCapabilities(forceRefresh = false) {
            this.loading = true;
            this.error = null;

            try {
                const url = `/api/banks/${this.bankId}/capabilities` + (forceRefresh ? '?refresh=1' : '');
                const response = await fetch(url);
                const data = await response.json();

                if (data.success) {
                    this.capabilities = data.capabilities;
                    this.cached = data.cached || false;
                    
                    if (data.cache_age) {
                        const hours = Math.floor(data.cache_age / 3600);
                        const minutes = Math.floor((data.cache_age % 3600) / 60);
                        this.cacheInfo = hours > 0 ? `vor ${hours}h ${minutes}m` : `vor ${minutes}m`;
                    }
                    
                    if (data.refresh_error) {
                        this.error = 'Hinweis: ' + data.refresh_error + ' (zeige gecachte Daten)';
                    }
                } else {
                    this.error = data.message || 'Fehler beim Laden der Bankfähigkeiten';
                }
            } catch (error) {
                this.error = 'Netzwerkfehler: ' + error.message;
            }

            this.loading = false;
        }
    }
}

function activityLog(bankId) {
    return {
        bankId: bankId,
        showLog: false,
        loadingLog: false,
        activities: [],
        
        formatDate(dateStr) {
            if (!dateStr) return '-';
            const date = new Date(dateStr);
            return date.toLocaleString('de-DE', {
                day: '2-digit',
                month: '2-digit',
                hour: '2-digit',
                minute: '2-digit'
            });
        },
        
        formatAction(action) {
            const actionNames = {
                'sync_all': '🔄 Alles synchronisieren',
                'fetch_balance': '💰 Saldo abrufen',
                'fetch_transactions': '📋 Transaktionen',
                'fetch_holdings': '📈 Wertpapiere',
                'fetch_accounts': '📁 Konten abrufen',
                'sync_error': '❌ Fehler'
            };
            return actionNames[action] || action;
        },
        
        async loadActivities() {
            this.loadingLog = true;
            try {
                const response = await fetch(`/api/banks/${this.bankId}/activity-log`);
                const data = await response.json();
                if (data.success) {
                    this.activities = data.activities;
                }
            } catch (error) {
                console.error('Failed to load activity log:', error);
            }
            this.loadingLog = false;
        },
        
        init() {
            // Load activities when log is first opened
            this.$watch('showLog', (value) => {
                if (value && this.activities.length === 0) {
                    this.loadActivities();
                }
            });
        }
    }
}

function bankDetails(bankId) {
    return {
        bankId: bankId,
        loading: false,
        syncingBalances: false,
        syncingAll: false,
        resettingSession: false,
        showTanModal: false,
        tanRequest: null,
        tanInput: '',
        submittingTan: false,
        message: null,
        isDecoupled: false,
        pollingInterval: null,
        pollingStatus: '',

        async resetSession() {
            if (!confirm('Session wirklich zurücksetzen? Dies löscht die gespeicherte Verbindung und erfordert beim nächsten Abruf möglicherweise eine neue TAN-Bestätigung.')) {
                return;
            }
            
            this.resettingSession = true;
            this.message = null;
            
            try {
                const response = await fetch(`/api/banks/${this.bankId}/reset-session`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();
                
                if (data.success) {
                    this.message = { type: 'success', text: data.message };
                } else {
                    this.message = { type: 'error', text: data.message || 'Fehler beim Zurücksetzen' };
                }
            } catch (error) {
                this.message = { type: 'error', text: 'Netzwerkfehler: ' + error.message };
            }
            
            this.resettingSession = false;
        },

        async syncAll() {
            this.syncingAll = true;
            this.message = null;

            try {
                const response = await fetch(`/api/banks/${this.bankId}/sync-all`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();

                if (data.needs_tan) {
                    this.tanRequest = data.tan_request;
                    this.isDecoupled = data.tan_request?.is_decoupled || false;
                    this.showTanModal = true;
                    
                    if (this.isDecoupled) {
                        this.pollingStatus = 'Bitte bestätigen Sie die Anfrage in Ihrer Banking-App...';
                        this.startDecoupledPolling();
                    }
                } else if (data.success) {
                    const stats = data.stats;
                    let msg = '✓ Synchronisierung abgeschlossen: ';
                    const parts = [];
                    if (stats.balances_updated > 0) parts.push(`${stats.balances_updated} Salden`);
                    if (stats.transactions_new > 0) parts.push(`${stats.transactions_new} neue Transaktionen`);
                    if (stats.transactions_updated > 0) parts.push(`${stats.transactions_updated} aktualisierte Transaktionen`);
                    if (stats.holdings_updated > 0) parts.push(`${stats.holdings_updated} Wertpapiere`);
                    msg += parts.length > 0 ? parts.join(', ') : 'Alles aktuell';
                    
                    if (stats.errors && stats.errors.length > 0) {
                        msg += ` (${stats.errors.length} Fehler)`;
                    }
                    
                    this.message = { type: 'success', text: msg };
                    setTimeout(() => location.reload(), 2000);
                } else {
                    this.message = { type: 'error', text: data.message || 'Fehler bei der Synchronisierung' };
                }
            } catch (error) {
                this.message = { type: 'error', text: 'Netzwerkfehler: ' + error.message };
            }

            this.syncingAll = false;
        },

        async fetchAccounts() {
            this.loading = true;
            this.message = null;

            try {
                const response = await fetch(`/api/banks/${this.bankId}/accounts`);
                const data = await response.json();

                if (data.needs_tan) {
                    this.tanRequest = data.tan_request;
                    this.isDecoupled = data.tan_request?.is_decoupled || false;
                    this.showTanModal = true;
                    
                    // Start polling for decoupled TAN
                    if (this.isDecoupled) {
                        this.pollingStatus = 'Bitte bestätigen Sie die Anfrage in Ihrer Banking-App...';
                        this.startDecoupledPolling();
                    }
                } else if (data.success) {
                    this.message = { type: 'success', text: 'Konten erfolgreich abgerufen!' };
                    setTimeout(() => location.reload(), 1000);
                } else {
                    this.message = { type: 'error', text: data.message || 'Fehler beim Abrufen der Konten' };
                }
            } catch (error) {
                this.message = { type: 'error', text: 'Netzwerkfehler: ' + error.message };
            }

            this.loading = false;
        },
        
        async syncBalances() {
            this.syncingBalances = true;
            this.message = null;

            try {
                const response = await fetch(`/api/banks/${this.bankId}/balances`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();

                if (data.needs_tan) {
                    this.tanRequest = data.tan_request;
                    this.isDecoupled = data.tan_request?.is_decoupled || false;
                    this.showTanModal = true;
                    
                    if (this.isDecoupled) {
                        this.pollingStatus = 'Bitte bestätigen Sie die Anfrage in Ihrer Banking-App...';
                        this.startDecoupledPolling();
                    }
                } else if (data.success) {
                    this.message = { type: 'success', text: `${data.updated_count} Kontosalden aktualisiert!` };
                    setTimeout(() => location.reload(), 1500);
                } else {
                    this.message = { type: 'error', text: data.message || 'Fehler beim Abrufen der Salden' };
                }
            } catch (error) {
                this.message = { type: 'error', text: 'Netzwerkfehler: ' + error.message };
            }

            this.syncingBalances = false;
        },

        startDecoupledPolling() {
            // Poll every 3 seconds
            this.pollingInterval = setInterval(() => this.checkDecoupledStatus(), 3000);
        },

        stopDecoupledPolling() {
            if (this.pollingInterval) {
                clearInterval(this.pollingInterval);
                this.pollingInterval = null;
            }
        },

        async checkDecoupledStatus() {
            try {
                const response = await fetch(`/api/banks/${this.bankId}/decoupled`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });
                const data = await response.json();

                if (data.status === 'pending') {
                    // Still waiting, continue polling
                    this.pollingStatus = 'Warte auf Bestätigung in der Banking-App...';
                } else if (data.needs_tan) {
                    // Another TAN needed (might be different type)
                    this.stopDecoupledPolling();
                    this.tanRequest = data.tan_request;
                    this.isDecoupled = data.tan_request?.is_decoupled || false;
                    if (this.isDecoupled) {
                        this.startDecoupledPolling();
                    }
                } else if (data.success) {
                    this.stopDecoupledPolling();
                    this.showTanModal = false;
                    this.syncingAll = false;
                    this.loading = false;
                    this.syncingBalances = false;
                    
                    // Check if this is a syncAll result (has stats)
                    if (data.stats) {
                        const stats = data.stats;
                        let msg = '✓ Synchronisierung abgeschlossen: ';
                        const parts = [];
                        if (stats.balances_updated > 0) parts.push(`${stats.balances_updated} Salden`);
                        if (stats.transactions_new > 0) parts.push(`${stats.transactions_new} neue Transaktionen`);
                        if (stats.transactions_updated > 0) parts.push(`${stats.transactions_updated} aktualisierte Transaktionen`);
                        if (stats.holdings_updated > 0) parts.push(`${stats.holdings_updated} Wertpapiere`);
                        msg += parts.length > 0 ? parts.join(', ') : 'Alles aktuell';
                        
                        if (stats.errors && stats.errors.length > 0) {
                            msg += ` (${stats.errors.length} Fehler)`;
                        }
                        
                        this.message = { type: 'success', text: msg };
                    } else {
                        // Regular account fetch success
                        this.message = { type: 'success', text: data.message || 'Konten erfolgreich abgerufen!' };
                    }
                    setTimeout(() => location.reload(), 2000);
                } else {
                    this.stopDecoupledPolling();
                    this.showTanModal = false;
                    this.syncingAll = false;
                    this.loading = false;
                    this.syncingBalances = false;
                    this.message = { type: 'error', text: data.message || 'Fehler bei der Bestätigung' };
                }
            } catch (error) {
                // Don't stop polling on network errors, just log
                console.error('Polling error:', error);
            }
        },

        async submitTan() {
            if (!this.tanInput.trim()) return;
            
            this.submittingTan = true;

            try {
                const response = await fetch(`/api/banks/${this.bankId}/tan`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ tan: this.tanInput })
                });
                const data = await response.json();

                if (data.needs_tan) {
                    this.tanRequest = data.tan_request;
                    this.isDecoupled = data.tan_request?.is_decoupled || false;
                    this.tanInput = '';
                    if (this.isDecoupled) {
                        this.startDecoupledPolling();
                    }
                } else if (data.success) {
                    this.showTanModal = false;
                    if (data.stats) {
                        const stats = data.stats;
                        let msg = '✓ Synchronisierung abgeschlossen: ';
                        const parts = [];
                        if (stats.balances_updated > 0) parts.push(`${stats.balances_updated} Salden`);
                        if (stats.transactions_new > 0) parts.push(`${stats.transactions_new} neue Transaktionen`);
                        if (stats.transactions_updated > 0) parts.push(`${stats.transactions_updated} aktualisiert`);
                        msg += parts.length > 0 ? parts.join(', ') : 'Keine Änderungen';
                        this.message = { type: 'success', text: msg };
                    } else if (data.new_count !== undefined) {
                        const msg = data.new_count > 0 
                            ? `${data.new_count} neue Transaktionen, ${data.updated_count || 0} aktualisiert`
                            : `${data.count || 0} Transaktionen geprüft (keine neuen)`;
                        this.message = { type: 'success', text: msg };
                    } else {
                        this.message = { type: 'success', text: data.message || 'TAN akzeptiert' };
                    }
                    setTimeout(() => location.reload(), 1500);
                } else {
                    this.message = { type: 'error', text: data.message || 'TAN-Fehler' };
                    this.showTanModal = false;
                }
            } catch (error) {
                this.message = { type: 'error', text: 'Netzwerkfehler: ' + error.message };
                this.showTanModal = false;
            }

            this.submittingTan = false;
            this.tanInput = '';
        },

        closeModal() {
            this.stopDecoupledPolling();
            this.showTanModal = false;
            this.tanInput = '';
            this.isDecoupled = false;
        }
    }
}
</script>
{% endblock %}
