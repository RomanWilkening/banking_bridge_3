{% block scripts %}
<script>
function editableName(type, id, initialName) {
    return {
        type: type,
        id: id,
        displayName: initialName,
        editName: initialName,
        editing: false,
        
        edit() {
            this.editName = this.displayName;
            this.editing = true;
            this.$nextTick(() => this.$refs.nameInput.focus());
        },
        
        async save() {
            if (!this.editName.trim()) {
                this.cancel();
                return;
            }
            
            const url = this.type === 'bank' 
                ? `/api/banks/${this.id}` 
                : `/api/accounts/${this.id}`;
            
            try {
                const response = await fetch(url, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name: this.editName.trim() })
                });
                const data = await response.json();
                
                if (data.success) {
                    this.displayName = this.editName.trim();
                    this.editing = false;
                } else {
                    alert(data.message || 'Fehler beim Speichern');
                }
            } catch (error) {
                alert('Netzwerkfehler: ' + error.message);
            }
        },
        
        cancel() {
            this.editName = this.displayName;
            this.editing = false;
        }
    };
}

function editableCredential(field, bankId, initialValue) {
    return {
        field: field,
        bankId: bankId,
        displayValue: initialValue,
        editValue: '',
        editing: false,

        edit() {
            this.editValue = this.field === 'password' ? '' : this.displayValue;
            this.editing = true;
            this.$nextTick(() => this.$refs.credInput.focus());
        },

        async save() {
            if (!this.editValue.trim()) {
                this.cancel();
                return;
            }

            try {
                const body = {};
                body[this.field] = this.editValue.trim();

                const response = await fetch(`/api/banks/${this.bankId}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                });
                const data = await response.json();

                if (data.success) {
                    if (this.field === 'password') {
                        this.displayValue = '••••••••';
                    } else {
                        this.displayValue = this.editValue.trim();
                    }
                    this.editing = false;
                } else {
                    alert(data.message || 'Fehler beim Speichern');
                }
            } catch (error) {
                alert('Netzwerkfehler: ' + error.message);
            }
        },

        cancel() {
            this.editValue = '';
            this.editing = false;
        }
    };
}

function accountItem(accountId, initialName, initialLinkedDepotId) {
    return {
        accountId: accountId,
        displayName: initialName,
        editName: initialName,
        editing: false,
        linkedDepotId: initialLinkedDepotId ? String(initialLinkedDepotId) : '',
        linkingDepot: false,
        
        startEdit() {
            this.editName = this.displayName;
            this.editing = true;
            this.$nextTick(() => this.$refs.nameInput.focus());
        },
        
        async saveName() {
            if (!this.editName.trim()) {
                this.cancelEdit();
                return;
            }
            
            try {
                const response = await fetch(`/api/accounts/${this.accountId}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name: this.editName.trim() })
                });
                const data = await response.json();
                
                if (data.success) {
                    this.displayName = this.editName.trim();
                    this.editing = false;
                } else {
                    alert(data.message || 'Fehler beim Speichern');
                }
            } catch (error) {
                alert('Netzwerkfehler: ' + error.message);
            }
        },
        
        cancelEdit() {
            this.editName = this.displayName;
            this.editing = false;
        },
        
        async linkDepot() {
            this.linkingDepot = true;
            
            try {
                const depotId = this.linkedDepotId ? parseInt(this.linkedDepotId) : null;
                const response = await fetch(`/api/accounts/${this.accountId}/link-depot`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ depot_id: depotId })
                });
                const data = await response.json();
                
                if (!data.success) {
                    alert(data.message || 'Fehler beim Verknüpfen');
                }
            } catch (error) {
                alert('Netzwerkfehler: ' + error.message);
            }
            
            this.linkingDepot = false;
        }
    };
}

